{
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist/mastande-frontend/browser",
  "framework": "angular",
  "redirects": [
    {
      "source": "/rooms",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|woff2|svg|png|jpg|webp|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "staging.umastande.co.za"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "staging.umastande.co.za"
        }
      ],
      "destination": "https://mastande-api.onrender.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "staging.umastande.co.za"
        }
      ],
      "destination": "https://mastande-api.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "mastande.vercel.app"
        }
      ],
      "destination": "https://mastande-api.onrender.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "mastande.vercel.app"
        }
      ],
      "destination": "https://mastande-api.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://api.umastande.co.za/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api.umastande.co.za/sitemap.xml"
    },
    {
      "source": "/((?!assets/|_next/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true
}
