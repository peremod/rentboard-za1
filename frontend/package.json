{
  "name": "mastande-frontend",
  "version": "1.65.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:staging": "ng build --configuration staging",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "lint": "echo \"No linter configured. Run npm run typecheck. See docs/OPERATIONS.md.\" && exit 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@angular/animations": "^21.2.14",
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/platform-browser": "^21.2.14",
    "@angular/platform-server": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@angular/ssr": "^21.2.14",
    "express": "^5.1.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.14",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.8"
  }
}
