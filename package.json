{
  "name": "mastande-za",
  "version": "1.169.0",
  "private": true,
  "description": "Mastande ZA — South Africa's room-letting notice board. Monorepo root (git hooks + workspace scripts only; app code lives in frontend/ and backend/).",
  "scripts": {
    "prepare": "husky",
    "frontend": "npm --prefix frontend run start",
    "backend": "npm --prefix backend run start:dev",
    "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "verify": "bash scripts/verify-build.sh",
    "audit:controls": "node scripts/control-contrast-audit.mjs",
    "audit": "npm run audit:routes && npm run audit:i18n && npm run audit:env && npm run audit:tokens && npm run audit:states && npm run audit:feedback && npm run audit:scale && npm run audit:fonts && npm run audit:controls && npm run lint:templates",
    "audit:css": "node scripts/css-coverage-audit.mjs",
    "audit:routes": "node scripts/route-audit.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "audit:i18n:strict": "node scripts/i18n-audit.mjs --strict",
    "audit:env": "node scripts/env-parity.mjs",
    "audit:tokens": "node scripts/token-lint.mjs",
    "audit:states": "node scripts/state-lint.mjs",
    "audit:feedback": "node scripts/feedback-lint.mjs",
    "audit:scale": "node scripts/scale-lint.mjs",
    "audit:fonts": "node scripts/font-lint.mjs",
    "audit:viewport": "node scripts/viewport-unit-lint.mjs",
    "audit:inbox-race": "node scripts/inbox-race-drive.mjs",
    "audit:house-ads": "node scripts/house-ads-drive.mjs",
    "lint:templates": "node scripts/template-literal-lint.mjs",
    "lighthouse": "npm --prefix frontend run build:prod && npx @lhci/cli@0.14.x autorun --config=lighthouserc.json",
    "og:generate": "python3 scripts/generate-og-image.py",
    "e2e": "playwright install chromium --with-deps >/dev/null 2>&1 || playwright install chromium; playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium --with-deps",
    "migrate:staging": "bash scripts/migrate-remote.sh --env staging",
    "test:backend": "vitest run --config vitest.config.mts",
    "test:backend:watch": "vitest --config vitest.config.mts",
    "test:backend:cov": "vitest run --config vitest.config.mts --coverage",
    "test:int": "DATABASE_URL=postgresql://rentboard:rentboard@localhost:5432/mastande_integration_test DIRECT_URL=postgresql://rentboard:rentboard@localhost:5432/mastande_integration_test vitest run --config vitest.integration.mts",
    "test:int:setup": "bash scripts/int-db-setup.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "4.13.0",
    "husky": "^9.1.6",
    "js-yaml": "^4.1.0",
    "vitest": "^4.1.10"
  }
}
