# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.angular/
build/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Test artefacts — Playwright writes traces, screenshots and videos here on
# every failing run. They are large, binary, and meaningless outside the run
# that produced them.
test-results/
playwright-report/
blob-report/
.playwright/

# A nested backend/backend or frontend/frontend means npm install ran from the
# wrong directory. Ignoring them stops the mistake reaching a commit.
backend/backend/
frontend/frontend/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Prisma
backend/prisma/migrations/dev/

# Misc
*.tsbuildinfo
.eslintcache
