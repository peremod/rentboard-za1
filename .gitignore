# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.angular/
build/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Test artefacts — Playwright writes traces, screenshots and videos here on
# every failing run. They are large, binary, and meaningless outside the run
# that produced them.
test-results/
playwright-report/
blob-report/
.playwright/

# A nested backend/backend or frontend/frontend means npm install ran from the
# wrong directory. Ignoring them stops the mistake reaching a commit.
backend/backend/
frontend/frontend/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Prisma
backend/prisma/migrations/dev/

# Misc
*.tsbuildinfo
.eslintcache

# Editor backups. nano writes <file>.save on an interrupted write, and one of
# those was staged alongside a real edit — exactly the sort of thing that ends
# up committed at 1am.
*.save
*.orig
*.rej

# Lighthouse CI run output — reports, not source.
.lighthouseci/

# Vercel build output — assembled by frontend/tools/vercel-build.mjs on every
# build, and committed by accident in 8790cd7 when a `git add -A` swept it in.
# Nothing here is source: 380 generated files, 6 MB, rewritten each time.
.vercel/

# Design-handoff package — a build artefact, regenerated by zipping the tree.
# 5.7MB of binary does not belong in git history; design-handoff/ itself does.
mastande-design-handoff.zip

# 🔴 DATABASE DUMPS. Never in git, and this is a POPIA rule rather than a
# housekeeping one: a dump of this product's database is real landlords, real
# tenants, real phone numbers and real document references. Committed once it
# is in the history for good — `git rm` removes it from the tree and leaves it
# in every clone and every fetch.
#
# mastande-pre-migrate-2026-10-05.dump sat untracked in the repository root on
# 20 October, one `git add -A` from being swept in. That is not hypothetical:
# the .vercel/ rule above exists because `git add -A` did exactly that in
# 8790cd7.
#
# ⚠️ NOT *.sql — backend/prisma/migrations/**/migration.sql is source and is
# tracked. Dumps are what is excluded, not SQL.
*.dump
*.dump.gz
*.pgdump
*.sql.gz
*.sql.bz2
