# ── Database (Supabase Postgres — see Capacity doc for pooled vs direct URL) ──
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Neon gives two connection strings. Both are needed and they are not
# interchangeable:
#
#   DATABASE_URL — the POOLED string, host contains "-pooler". Used by the
#                  running app, which opens many short connections.
#   DIRECT_URL   — the UNPOOLED string. Used only by `prisma migrate`, which
#                  needs a session-level connection. Migrations fail against
#                  the pooler with a confusing advisory-lock error.
#
# Add ?sslmode=require to both.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Auth ──
#
# ⚠️ JWT_SECRET does more than sign tokens: it is also the HMAC key for every
# one-time code stored in the database — phone sign-in codes, phone sign-up
# codes, and the short-lived ticket that proves a number during sign-up. That is
# deliberate (a keyed MAC means a read-only database leak stops handing out live
# codes), and it has one operational consequence worth knowing before you act:
# **rotating this secret invalidates every code and ticket in flight.** They
# expire in 10–20 minutes anyway, so the cost is that a handful of people
# re-request one — but rotate it at a quiet hour, not mid-morning.
JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""
# Short-lived by design — see README §20. The refresh token (httpOnly
# cookie, rotated on every use) is what keeps the session alive, not this.
# Must be a DIFFERENT value from JWT_SECRET. Sharing them defeats the point of
# having two — a stolen access token would then also mint refresh tokens.
# The API refuses to start if these match.
# JWT_REFRESH_SECRET is not used. Refresh tokens are random strings stored as
# SHA-256 hashes in the refresh_tokens table, not signed JWTs — there is no
# secret to configure. Left documented so nobody re-adds it.""

JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── ImageKit ──
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Optional. Leave BLANK in every real environment — it defaults to
# https://api.imagekit.io.
#
# It exists so scripts/storage-drive.mjs can point file deletion at a local stub
# and prove a DELETE actually goes out, on a machine with no ImageKit account.
# Set anywhere real, uploaded files would never be deleted and the retention
# promises in the privacy policy and the PAIA manual would stop being true.
#
# Note the private key above is what deletion authenticates with. Without it,
# nothing is deleted and the hourly drain says so at error level.
IMAGEKIT_API_BASE=

# ── PayFast (ZAR) — landlord verification fee ──
# Sandbox: https://sandbox.payfast.co.za — merchant id 10000100, key 46f0cd694581a
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Optional on PayFast, but if set on the account it MUST be set here too, or
# every payment is rejected for a signature mismatch.
PAYFAST_PASSPHRASE=
# Set to false only for live payments.
PAYFAST_SANDBOX=true
# Public URL of this API — used to build the ITN notify_url PayFast calls.
# Must be reachable from the internet: localhost will never receive an ITN.
# Use ngrok or similar when testing locally.
API_URL=http://localhost:3000

# ── Resend ──
RESEND_API_KEY=
RESEND_FROM=noreply@umastande.co.za
RESEND_FROM_NAME=Mastande

# Where operational alerts go — fraud reports, failed webhooks, payment
# reconciliation warnings. Read by config/configuration.ts and set in
# render.yaml, but it was never documented here, so anyone provisioning a new
# environment from this file alone would have had alerts silently disabled.
ADMIN_ALERT_EMAIL=admin@umastande.co.za
# Resend dashboard -> Webhooks -> signing secret (whsec_...). Required in
# production — the boot fails without it — and the webhook refuses every
# delivery with 503 when it is unset, rather than acting on unsigned requests.
# Set it locally too if you need to exercise POST /api/notifications/webhook/resend.
RESEND_WEBHOOK_SECRET=

# ── WhatsApp Business API (Meta) ──
# ⚠️ THE MASTER SWITCH. Anything but the exact string "true" means OFF, and OFF
# is the default — including when this line is missing entirely.
#
# Meta bills PER MESSAGE. An authentication message to a South African number
# is about USD $0.0095 + VAT, from the very first one, with no free allowance.
# On a product that is free to list and free to apply that is a per-head cost
# with no revenue behind it, so the channel stays off until somebody decides to
# pay for it.
#
# While it is off: no Cloud API call is ever made, the webhook is refused, and
# the phone sign-in endpoints answer 503 saying to use an email address. The
# screens still exist and say so plainly — nothing is deleted, and setting this
# to true with the credentials below brings the whole channel back.
#
# It does NOT affect wa.me links — sharing a room, or tapping "WhatsApp" on a
# plumber in the directory, opens the person's own WhatsApp and Meta bills
# nobody for that.
#
# See docs/WHATSAPP-SETUP.md and docs/OUTSTANDING.md §29.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# A string you invent. Meta echoes it back ONCE, during the GET handshake,
# to prove the URL is yours. It says nothing about any later POST.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret — App Dashboard -> Settings -> Basic -> App Secret.
# This is what signs every inbound webhook (X-Hub-Signature-256). Without it
# the webhook refuses every delivery rather than trusting unsigned ones, so
# inbound replies and listing drafts stop arriving. Set it together with
# WHATSAPP_ACCESS_TOKEN.
WHATSAPP_APP_SECRET=

# ── Message templates ──
# Meta permits free-form `type: 'text'` ONLY inside the 24-hour customer
# service window — within 24 hours of the person messaging us. A
# business-initiated message outside that window is rejected (error 131047)
# unless it uses a pre-approved template.
#
# ⚠️ A sign-in code is business-initiated BY DEFINITION — it goes to somebody
# who has not messaged us — so it is always outside the window. Credentials set
# with this left blank is the state that looks configured and delivers nothing;
# the API logs a warning at boot saying so.
#
# The name of an AUTHENTICATION template, approved in the Meta console:
# WhatsApp Manager -> Message templates -> Create template -> Authentication.
# Meta writes the body; you choose the expiry and the copy-code button. Lower
# case and underscores only. Leave blank until it is APPROVED, not merely
# submitted — a name Meta does not hold fails with 132001.
WHATSAPP_TEMPLATE_OTP=
# The language the template was APPROVED under, not the reader's language.
# Meta treats name+language as one identity, so sending `en_US` to a template
# approved as `en` fails with 132001 — which reads like a typo in the name and
# is not one. Default: en
WHATSAPP_TEMPLATE_LANG=en
#
# ── NOT YET BUILT: templates for everything else ──
# These three paths are still free-form text and so still fail outside the
# window — they degrade honestly rather than breaking, because each is a bonus
# channel on top of email or an in-app notice:
#   · notifyLandlord      — a tenant applied, or sent a message
#   · sendToNumber        — rent reminders, reference requests, notices
#   · the listing bot's replies — the ONE case that is genuinely fine, because
#     the landlord messaged us first and is inside the window
# Each needs its own UTILITY template and its own Meta approval. See
# docs/OUTSTANDING.md §27 and PRE-LAUNCH-CHECKLIST.md row 40.
# WHATSAPP_TEMPLATE_SURVEY=

# Where the Cloud API lives. Leave it blank — an operator never sets this. It
# exists so scripts/whatsapp-template-drive.mjs can point a send at a stub and
# read what we actually put on the wire, because every WhatsApp send in this
# codebase was written from documentation and none of it had ever been
# observed. Blank means https://graph.facebook.com
WHATSAPP_GRAPH_BASE_URL=

# ── App ──
PORT=3000
# BUILD environment. Libraries key off this for performance and error verbosity.
# Set to `production` on staging too — that is correct and intended.
NODE_ENV=development

# DEPLOYMENT environment: development | staging | production.
#
# Deliberately separate from NODE_ENV. Everything that must differ between
# staging and production keys off THIS — search indexability, CORS origins,
# payment sandbox mode. Never off NODE_ENV, which is `production` on staging.
#
# Unset defaults to `development`, which is the safe direction: not indexable,
# not accepting production origins.
APP_ENV=development

# Public origin of the FRONTEND for this environment, no trailing slash.
# Used to build sitemap.xml and robots.txt. Must differ per environment or
# staging will publish production URLs and be treated as a duplicate site.
#   development  http://localhost:4200
#   staging      https://staging.umastande.co.za
#   production   https://umastande.co.za
#
# Required. The API refuses to start without it. There is no fallback, because
# the old fallback was the production origin — so a misconfigured staging box
# published production URLs in its own sitemap and looked fine in every log.
SITE_URL=http://localhost:4200
FRONTEND_URL=http://localhost:4200
