// ═══════════════════════════════════════════════════════════
// Mastande ZA — Prisma Schema
// PostgreSQL via Supabase.
//
// Design decisions:
// - Monetary values stored as INTEGER ZAR cents — avoids float bugs.
// - UUID primary keys — safe to expose in URLs.
// - Soft status transitions on Room — data is never hard-deleted.
// - Images stored as ImageKit file paths, not full URLs.
//
// Growth log: User/LandlordProfile/TenantProfile/Room (v0.1.0) →
// Application/Message/LandlordWhatsappConfig (v0.5.0) →
// RoomBoost/RentersPassport (v0.8.0) → RefreshToken (v0.9.2, this pass,
// auth hardening) — see README §Roadmap.
// ═══════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  TENANT
  LANDLORD
  ADMIN
}

enum RoomType {
  shared_house
  en_suite
  studio
  private
}

enum RoomStatus {
  draft
  active
  reserved
  let
  paused
  deleted
}

enum PlanTier {
  free
  pro
  agency
}

/// Core user account — shared by tenants, landlords, and admins.
model User {
  id                String    @id @default(uuid())
  /// Optional since v1.85.0 (Phase 7g).
  ///
  /// Many township landlords are WhatsApp-first and do not use email at all.
  /// Requiring one meant either turning them away or inventing an address on
  /// their behalf, and an invented address is one nobody reads — so a password
  /// reset or a "you have an applicant" notice would go nowhere and look
  /// delivered.
  ///
  /// A database CHECK constraint enforces that email OR phone is present; see
  /// the migration. Nullable here, guaranteed non-empty as a pair there, because
  /// "at least one of two columns" is not something Prisma can express and is
  /// far too important to leave to whichever code path happens to run.
  email             String?   @unique
  passwordHash      String?
  role              UserRole  @default(TENANT)
  fullName          String
  avatarPath        String?
  /// When this account was last shown round the product — Phase 7f.
  ///
  /// Null means never. Server-side rather than in the browser: a phone here is
  /// shared and replaced, so a per-browser flag shows the walkthrough to people
  /// who have seen it and hides it from people who have not — and under SSR
  /// there is no localStorage to read on the first paint anyway.
  ///
  /// Cleared by "Show me around again", which is why it is a nullable timestamp
  /// and not a boolean that only ever goes one way.
  walkthroughSeenAt DateTime?

  /// Screen keys whose first-use hint this account has put away.
  ///
  /// Keys only — no timestamps, no order. "Has this person dismissed this
  /// hint?" is the only question asked of it, and storing when they saw each
  /// screen would be a movement trail nothing reads (POPIA s.10).
  hintsSeen         String[]  @default([])
  /// A login identifier since v1.85.0 (Phase 7g) — but NOT `@unique` here, and
  /// that is deliberate.
  ///
  /// Uniqueness is enforced by a PARTIAL unique index, on verified numbers only:
  ///
  ///     CREATE UNIQUE INDEX ... ON users(phone) WHERE "phoneVerified" = true;
  ///
  /// Why not a plain `@unique`: this column has never been unique, so duplicates
  /// already exist — the dev database had forty accounts sharing one number, and
  /// production may well have people who mistyped, or a household sharing a
  /// handset. A full unique index would fail to create, and the only way to make
  /// it succeed would be to null out other people's saved numbers, which is
  /// destroying user data to satisfy a constraint.
  ///
  /// Verified numbers are the ones that matter: `requestCode` only ever finds a
  /// user with `phoneVerified: true`, so two unverified duplicates cannot make a
  /// login ambiguous. Two VERIFIED duplicates could, and the partial index makes
  /// that impossible.
  ///
  /// ⚠️ Prisma cannot express a partial unique index, so it will report this
  /// index as drift on `migrate dev` and offer to remove it. Do not let it. This
  /// repository applies hand-written migrations with `migrate deploy`, where the
  /// extra index is left alone.
  phone             String?
  isVerified        Boolean   @default(false)
  /// ⚠️ The ADMIN suspension switch, not a self-service control — Phase 7g.
  ///
  /// Every sign-in path refuses a false value with "Your account has been
  /// suspended. Please contact support." A person deactivating their own
  /// account must still be able to sign in, or they can never reactivate, so
  /// that case uses `deactivatedAt` instead. Reusing this one would have
  /// looked like a one-line feature and shipped a trapdoor.
  isActive          Boolean   @default(true)
  /// The owner's own pause — Phase 7g. Sign-in still works; the account is off
  /// the board and sends nothing. Null means live. Reversible by its nature.
  deactivatedAt     DateTime?
  /// The end — Phase 7g. The row stays as a TOMBSTONE with every personal
  /// field erased, because `DELETE FROM users` cascades into other people's
  /// rooms, applications, messages, tenancies, rent history and reviews. See
  /// the migration for the full list and for why POPIA does not require that.
  deletedAt         DateTime?
  /// 'email', 'magic_link', 'google', 'facebook', 'phone'. Kept as a string
  /// rather than an enum so adding a provider does not need a migration —
  /// 'phone' arrived in v1.85.1 and needed no schema change, which is the
  /// decision paying off.
  authProvider      String    @default("email")
  authProviderId    String?

  /// Verified mobile number, for OTP sign-in over WhatsApp or SMS.
  ///
  /// Separate from `phone`, which a landlord enters for contact purposes and
  /// nobody has checked. Signing someone in on an unverified number would let
  /// anyone claim an account by typing a number they do not own.
  phoneVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  /// Last authenticated request, rounded and written at most hourly.
  ///
  /// One timestamp, overwritten — not an event log. It answers "how many
  /// people used the app this week" without recording what anyone did or
  /// when, and it cannot reconstruct a session or a journey. lastLoginAt
  /// alone was not enough: with a 15-minute token and silent refresh, someone
  /// using the app daily may not log in for weeks.
  lastSeenAt DateTime?

  /// POPIA s.69: marketing needs consent and a working opt-out. Transactional
  /// mail about a room you applied for is unaffected by this.
  marketingEmails Boolean @default(true)

  authTokens          AuthToken[]
  tenanciesAsLandlord Tenancy[]       @relation("TenanciesAsLandlord")
  tenanciesAsTenant   Tenancy[]       @relation("TenanciesAsTenant")
  reviewsWritten      Review[]        @relation("ReviewsWritten")
  reviewsReceived     Review[]        @relation("ReviewsReceived")
  /// Private notes this landlord wrote. Theirs; nobody else reads them.
  notesWritten        LandlordNote[]  @relation("NotesWritten")
  /// Notes OTHER landlords wrote about this user. Present so deleting the
  /// account removes them — they are about a person with a s.24 right to
  /// erasure. No endpoint reads this side.
  notesAbout          LandlordNote[]  @relation("NotesAbout")
  /// In-app notices. The channel that works when there is no email address and
  /// WhatsApp is outside its 24-hour window — see the Notice model.
  notices             Notice[]
  /// The sign-up this account came from, when it was created by phone. Holds the
  /// evidence that this person accepted the terms themselves — see PhoneSignup.
  phoneSignup         PhoneSignup?
  reportsFiled        Report[]        @relation("ReportsFiled")
  reportsAgainst      Report[]        @relation("ReportsAgainst")
  flagsRaised         TenancyFlag[]   @relation("FlagsRaised")
  flagsAgainst        TenancyFlag[]   @relation("FlagsAgainst")
  properties          Property[]      @relation("PropertiesOwned")
  whatsappDrafts      WhatsappDraft[] @relation("WhatsappDrafts")

  /// Open or upheld post-tenancy flags against this account.
  ///
  /// Denormalised because the board's ordering needs it in SQL and a join
  /// per room is not worth it. Maintained in the same transaction as every
  /// flag create and review, so it cannot drift from one of those — but it
  /// CAN drift if rows are edited by hand, and AdminService.recountFlags()
  /// exists to put it right.
  openFlagCount    Int                   @default(0)
  emailLogs        EmailLog[]
  payments         Payment[]
  referralCodes    ReferralCode[]        @relation("ReferralCodesOwned")
  referralsMade    Referral[]            @relation("ReferralsMade")
  referralReceived Referral?             @relation("ReferralReceived")
  savedRooms       SavedRoom[]
  savedSearches    SavedSearch[]
  verifications    VerificationRequest[]

  landlordProfile LandlordProfile?
  tenantProfile   TenantProfile?
  rooms           Room[]
  applications    Application[]
  messagesSent    Message[]
  refreshTokens   RefreshToken[]
  expenses        Expense[]        @relation("ExpensesRecorded")

  @@index([email])
  @@index([role])
  @@map("users")
  /// Phase 7i. The record of this account being ended, and the records of the
  /// accounts this admin ended.
  accountClosure    AccountClosure?  @relation("ClosedAccount")
  closuresPerformed AccountClosure[] @relation("ClosuresByAdmin")
  /// Phase 7k. Contractor numbers this landlord was handed. Nulled on closure.
  contractorLeads ContractorLead[] @relation("ContractorLeads")
  /// Phase 7l. Viewings this person called off — either side may.
  viewingsCancelled RoomViewing[] @relation("ViewingsCancelled")

  /// Lost-number recoveries — Phase 7q. The first is this account's own
  /// (cascades with it); the other two are ones this admin handled, SET NULL on
  /// their deletion so the record outlives the staff member.
  recoveries         AccountRecovery[] @relation("RecoveredAccount")
  recoveriesOpened   AccountRecovery[] @relation("RecoveriesOpened")
  recoveriesApproved AccountRecovery[] @relation("RecoveriesApproved")

  /// Sign-ups this admin started for somebody else — Phase 7p. SET NULL on
  /// their own deletion, so the record of the help outlives the staff member.
  phoneSignupsAssisted PhoneSignup[] @relation("PhoneSignupsAssisted")
}

model LandlordProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String?
  planTier      PlanTier  @default(free)
  planExpiresAt DateTime?
  idVerified    Boolean   @default(false)

  /// Days after the 1st before an unpaid month triggers a reminder.
  ///
  /// Per landlord because pay dates here are not uniform — someone whose
  /// tenants are all on a month-end wage wants a different window from
  /// someone whose tenants are on SASSA, which pays on a published schedule
  /// in the first week. A fixed global number would be wrong for most of them.
  /// 0 disables reminders for that landlord without disabling the tracking.
  rentGraceDays  Int                     @default(3)
  rating         Float?
  ratingCount    Int                     @default(0)
  whatsappConfig LandlordWhatsappConfig?

  // ── Public storefront (Phase 5b) ─────────────────────────────────────────
  //
  // A real, indexable page per landlord. Not only a retention feature: it is an
  // SEO surface, so it carries a stable human-readable URL rather than a uuid.

  /// The storefront's URL segment, e.g. `thabo-mokoena`. Unique across all
  /// landlords, and STABLE once set — it is in the sitemap and in whatever
  /// people have shared, so regenerating it on a name change would 404 every
  /// link that ever pointed at it. Null until the landlord has a storefront.
  slug String? @unique

  /// The landlord's own words about themselves. Optional; nothing is invented
  /// on their behalf, because a bio written by the platform is a claim the
  /// platform is making about a person.
  bio String?

  /// ImageKit path for a logo or photo. Public, unlike a verification
  /// document — it is on a page whose whole purpose is being seen.
  logoPath String?

  /// Whether the storefront is published. Off by default: a page about someone
  /// that they have not looked at should not be indexable, and the same
  /// reasoning as Survey.active and ServiceProvider.active.
  storefrontLive Boolean @default(false)

  @@map("landlord_profiles")
}

model TenantProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employmentStatus  String?
  annualIncomeCents Int?
  incomeVerified    Boolean   @default(false)
  idVerified        Boolean   @default(false)
  hasPassport       Boolean   @default(false)
  passportExpiresAt DateTime?

  @@map("tenant_profiles")
}

/// Who is letting a room out, and on what footing — Phase 6.
///
/// ── Why this is on the LISTING and not on the user
///
/// The same person can be both. A landlord who owns a yard in Tembisa may also
/// rent a flat in town and sublet its spare room; a tenant who sublets one room
/// this year may buy next year. "Sublessor" is not a kind of person, it is a
/// description of one letting arrangement, and putting it on `User` would make
/// the platform ask somebody to choose an identity when what it needs to know is
/// a fact about this room.
///
/// It is also the whole of Option A (the architectural decision the Phase 6
/// brief required sign-off on, taken 2026-10-03). `UserRole` keeps its three
/// values, `LandlordProfile` stays landlord-only, and a `TENANT` may hold a
/// listing whose `listerType` is `sublessor`. Option B — generalising
/// "Landlord" into "Room Provider" — is cleaner in the long run and touches
/// every guard, dashboard and string in the product; this does not.
///
/// ⚠️ The consequence to know about: `Room.landlordId` now sometimes points at
/// a `TENANT`. The column name is wrong and is left alone deliberately —
/// renaming it means rewriting every query, index and DTO that mentions it, for
/// no behavioural gain, and a half-done rename is worse than a known misnomer.
/// Read it as "the account that holds this listing".
enum ListerType {
  /// The owner, or somebody with the owner's mandate to let. Every listing that
  /// existed before Phase 6, which is why it is the default.
  owner_landlord
  /// A tenant letting out a room in a place they themselves rent. The platform
  /// does NOT confirm they are allowed to — see the disclaimer on the room page
  /// and `Room.subletCheckedAt` for what is and is not checked.
  sublessor
}

/// How the household runs, for the compatibility filters — Phase 6.
///
/// On Property with `housemateProfile`, for the reason given on that block: four
/// rooms at one address have one household, and asking for these four times
/// guarantees the four answers disagree in front of the person choosing.
///
/// Every one of these has an `unstated` default and `unstated` is never
/// rendered. A silent default would put a claim about the people someone would
/// be living with in front of them that nobody ever made.
enum HouseholdSchedule {
  /// Out at work or college on weekdays — the house is quiet in the day.
  weekday_working
  /// Shifts, so somebody is often sleeping at odd hours. Worth saying: it is
  /// the single most common source of friction in a shared house here.
  shift_work
  /// Somebody is usually home — working from home, studying, or not working.
  mostly_home
  varied
  unstated
}

enum HouseholdCleanliness {
  /// Cleaned on a rota, kitchen done the same day.
  very_tidy
  /// Tidy enough: dishes get done, nobody is inspecting.
  tidy_enough
  relaxed
  unstated
}

enum HouseholdSocial {
  /// People eat together, visitors are normal.
  social
  /// Civil but private. Early nights.
  quiet
  balanced
  unstated
}

/// Room — the core listing entity. Rooms-only MVP (no full-property lets).
model Room {
  id         String @id @default(uuid())
  landlordId String
  landlord   User   @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  roomType    RoomType
  title       String
  description String?
  status      RoomStatus @default(draft)

  /// Monthly rent in ZAR cents: R950/mo = 95000
  rentCents     Int
  depositCents  Int?
  billsIncluded Boolean @default(false)

  province        String
  city            String
  locationDisplay String

  availableFrom   DateTime
  housematesCount Int      @default(0)

  couplesAllowed    Boolean @default(false)
  dssAccepted       Boolean @default(false)
  guarantorAccepted Boolean @default(false)
  petsAllowed       Boolean @default(false)

  /// What the room and house actually have. Stored as a string array rather
  /// than 15 booleans: the list will grow, and a Postgres array can be
  /// filtered with `hasEvery` without a migration each time.
  ///
  /// Values come from AMENITIES in the frontend so the two stay in step.
  amenities String[] @default([])

  /// The yard this room belongs to, if the landlord has grouped it.
  /// Optional: a landlord with one room is not made to create a container.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  /// Owner-let or sublet — Phase 6. See the ListerType comment for why this is
  /// a fact about the listing rather than about the account that holds it.
  listerType ListerType @default(owner_landlord)

  /// When an admin checked this sub-lessor's right to sublet THIS address, and
  /// approved it. Null on every owner listing and on every unchecked sublet.
  ///
  /// ── Why it is a date and not a boolean
  ///
  /// Because what can honestly be shown to an applicant is "a lease and a
  /// consent to sublet were checked on 14 March", not "this person may
  /// sublet". The head landlord can withdraw consent the day after and nothing
  /// tells us. A boolean would read as a guarantee the platform is in no
  /// position to make, and the applicant — not the platform — carries the loss
  /// if the right turns out to be invalid.
  ///
  /// ── Why it is per ROOM and not per person
  ///
  /// The right to sublet is granted by one lease over one address. Somebody
  /// allowed to sublet in Yeoville is not thereby allowed to sublet in Soweto,
  /// and a per-user flag would say they were.
  subletCheckedAt DateTime?

  heroImagePath String?
  imagePaths    String[]

  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?

  /// Lifetime page loads, never reset. Phase 7d added `viewDays` for the
  /// question this cannot answer: whether anybody is looking NOW.
  viewCount        Int       @default(0)
  applicationCount Int       @default(0)
  relistCount      Int       @default(0)
  letAt            DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  applications Application[]
  tenancies    Tenancy[]
  reviews      Review[]
  savedBy      SavedRoom[]
  reports      Report[]
  expenses     Expense[]

  /// Verification requests about this listing — currently only `sublet_right`.
  verifications VerificationRequest[]
  /// Phase 7d. One row per day a room was looked at, so "viewed 47 times this
  /// week" is a fact rather than a sentence from the design document.
  viewDays      RoomViewDay[]

  @@index([status])
  @@index([province, city])
  @@index([rentCents])
  @@index([landlordId])
  @@index([propertyId])
  /// The board filters on this together with status, and a sublet-only search
  /// is one of the two headline Phase 6 filters.
  @@index([status, listerType])
  @@map("rooms")
}

/// How many times a room was looked at, by day — Phase 7d.
///
/// `Room.viewCount` is a lifetime integer, so the dashboard could say "200
/// views" and not whether a single one of them was this month. A landlord's
/// actual question is whether the listing is working now, and a number that
/// only ever goes up cannot answer it.
///
/// No viewer identity, deliberately: a counter per room per day answers the
/// question, and storing who looked would be collecting personal data for a
/// purpose that does not need it (POPIA s.10).
model RoomViewDay {
  roomId String
  room   Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Calendar date in UTC, as every other day-grain figure here is keyed.
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([roomId, day])
  @@index([day])
  @@map("room_view_days")
}

enum ApplicationStatus {
  pending
  viewed
  shortlisted
  accepted
  rejected
  withdrawn
}

/// A tenant's application to a room. One tenant can apply to a given room only once.
model Application {
  id        String            @id @default(uuid())
  roomId    String
  room      Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    User              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(pending)
  coverNote String?

  /// Why the landlord rejected. Also distinguishes a deliberate rejection from
  /// one caused by accepting someone else, which undo-accept must reverse
  /// while leaving deliberate ones alone.
  rejectionReason String?
  viewedAt        DateTime?
  decidedAt       DateTime?

  /// Which letting cycle this application belongs to — mirrors Room.relistCount
  /// at the time it was submitted. Relisting a room starts a new cycle so its
  /// old applicants do not reappear as new ones.
  cycle Int @default(0)

  /// Set when the room is relisted or let to someone else. Archived
  /// applications stay visible to the tenant (with the reason) and are hidden
  /// from the landlord's current applicant list. Never deleted: the privacy
  /// policy commits to retaining applications for 2 years after outcome.
  archivedAt DateTime?

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Scoped to the cycle: a tenant who missed out may apply again after a
  // relist. The old constraint locked them out of the room permanently.
  tenancy Tenancy?

  @@unique([roomId, tenantId, cycle])
  @@index([tenantId])
  @@index([roomId, status])
  @@index([roomId, cycle])
  @@map("applications")
  /// Phase 7l. Viewings arranged on this application.
  viewings RoomViewing[]
}

/// Single-use, short-lived token for password reset and email change.
///
/// Only a SHA-256 hash of the token is stored: a leaked database must not hand
/// an attacker working reset links. The raw token exists only in the email.
model AuthToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String        @unique
  type      AuthTokenType
  /// For email-change requests: the address being moved to, confirmed by the
  /// token before it is written to the account.
  newEmail  String?

  /// For number-change requests: the mobile being moved to — Phase 7o.
  ///
  /// ⚠️ The reason this column exists is that changing a number used to be a
  /// free-text edit on the profile form, which un-verified it. On an account
  /// with no email and no password that is the only credential, so one mistyped
  /// digit was a permanent, silent lockout: the account pointed at a number
  /// nobody held, and asking for a code on the real one answered "a code is on
  /// its way" and sent nothing, because that reply is identical for a number
  /// with no account.
  ///
  /// So a change is PROVEN BEFORE IT LANDS. The code goes to the new number,
  /// the account keeps the old one until it comes back, and a typo can never be
  /// stored as the way in — the same shape as `newEmail` beside it.
  ///
  /// A CHECK constraint ties this column to the `phone_change` type in both
  /// directions.
  newPhone  String?

  /// Wrong guesses against THIS token.
  ///
  /// Added because the service had a `MAX_ATTEMPTS = 5` constant that nothing
  /// ever read — it described an intention and counted nothing, and its own
  /// header says so. There was nowhere to count: this column is that somewhere.
  ///
  /// Per-token and therefore per-account, which the existing @Throttle is not —
  /// that is per IP, so ten guesses per IP per fifteen minutes. A distributed
  /// attacker gets more than one IP; the person whose account it is gets one
  /// budget of guesses regardless.
  attempts Int @default(0)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// A safety report against a listing or a user.
///
/// The disclaimer warns tenants about agents posing as landlords, deposit
/// scams and discriminatory listings, and tells them to report — so there has
/// to be somewhere for that to go, with a record. Reports are retained after
/// resolution because a pattern across several reports is usually what shows a
/// scammer, not any single one.
model Report {
  id String @id @default(uuid())

  /// Null when reported by a signed-out visitor.
  reporterId String?
  reporter   User?   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)

  /// One of these is set. Reporting a room implicates its landlord, but the
  /// landlord may also be reported directly (e.g. off-platform conduct).
  roomId         String?
  room           Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reportedUserId String?
  reportedUser   User?   @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: SetNull)

  reason       ReportReason
  details      String
  /// Contact address for signed-out reporters, so we can follow up.
  contactEmail String?

  status         ReportStatus @default(open)
  /// What the admin did and why. Shown to nobody but admins.
  resolutionNote String?
  reviewedById   String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([roomId])
  @@index([reportedUserId])
  @@map("reports")
}

enum ReportReason {
  not_a_real_listing // room does not exist, or photos are stolen
  agent_posing_as_landlord
  upfront_payment_demanded // deposit before viewing — the biggest scam pattern
  discriminatory // PEPUDA / Constitution s.9
  misleading_details // price, size or condition materially wrong
  harassment
  already_let // still advertised after being taken
  other
}

enum ReportStatus {
  open
  investigating
  actioned // listing removed, account suspended, or similar
  dismissed
}

/// A letting that actually happened.
///
/// WHY THIS EXISTS: reviews need something to hang off. An accepted
/// application says a landlord chose someone; it does not say anyone moved in,
/// how long they stayed, or when it ended. Without that, nothing can decide
/// when a review becomes due, or stop someone reviewing a room they never
/// lived in.
///
/// Created when an application is accepted, then confirmed by the parties.
/// Deliberately NOT auto-started: an accepted application often falls through
/// before move-in, and a tenancy nobody confirms should not generate a review
/// prompt or a rating.
model Tenancy {
  id String @id @default(uuid())

  roomId     String
  room       Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  landlordId String
  landlord   User   @relation("TenanciesAsLandlord", fields: [landlordId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     User   @relation("TenanciesAsTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  /// The application this came from. One tenancy per accepted application.
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status TenancyStatus @default(pending)

  /// Agreed move-in date. Null until confirmed. This is the lease start; there
  /// is no separate `leaseStartDate`, because a second date meaning the same
  /// thing is a second date to keep in sync.
  startDate DateTime?
  /// Actual move-out. Set when the tenancy is ended by either party.
  ///
  /// NOT the same as `leaseEndDate`, and the distinction matters: this is what
  /// happened, that is what was agreed. A tenancy can end early, run over, or
  /// have no agreed end at all. Conflating them would make the renewal flag
  /// fire on tenancies that had already ended.
  endDate   DateTime?

  /// When the fixed term ends, if there is one.
  ///
  /// Null means MONTH-TO-MONTH, which is the common case in this market and is
  /// not a missing value. A null here is why the renewal flag cannot simply be
  /// "leases ending soon": most tenancies never have an end date, and the thing
  /// that ends them is notice.
  leaseEndDate DateTime?

  /// Days of notice the LEASE requires, as the parties agreed it.
  ///
  /// The platform does not assert what the law requires and this field is not
  /// legal advice. South African notice periods depend on the agreement and on
  /// whether the Consumer Protection Act applies, which turns on facts this
  /// product does not know. 30 is the default because a calendar month is what
  /// most leases in this market say, not because it is a statutory figure.
  noticePeriodDays Int @default(30)

  /// When notice was given, and by whom — null while nobody has given any.
  ///
  /// A month-to-month tenancy has nothing to count down to until this is set.
  /// It is what starts the countdown and the relist prompt, which is why it is
  /// a recorded event rather than something inferred from a status change.
  noticeGivenAt   DateTime?
  noticeGivenById String?

  /// Rent at the time, in ZAR cents. Copied rather than referenced because the
  /// room's rent changes on relist and a review should reflect what was paid.
  rentCents Int

  /// Either party may end it — this is a record of fact, not a negotiation.
  endedById String?
  endReason String?

  /// Reviews open when the tenancy ends and close after this. A window stops
  /// a grudge review appearing two years later, and gives the double-blind
  /// reveal a definite deadline.
  reviewsCloseAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews     Review[]
  flags       TenancyFlag[]
  rentPeriods RentPeriod[]
  documents   LeaseDocument[]

  @@index([landlordId, status])
  @@index([tenantId, status])
  @@index([roomId])
  @@map("tenancies")
}

enum TenancyStatus {
  pending // accepted, not yet confirmed as moved in
  active // confirmed, currently living there
  ended // completed normally
  cancelled // fell through before move-in — never generates reviews
}

/// A review written after a tenancy ends.
///
/// DOUBLE-BLIND: neither side's review is visible until both have submitted,
/// or the review window closes. If each party could read the other's first,
/// ratings become a negotiation and honest criticism stops.
///
/// VISIBILITY DIFFERS BY TYPE, and this is deliberate:
///
///   room, landlord  -> public. Tenants are choosing where to live and need
///                      to see what previous tenants said.
///   tenant          -> NOT public. Visible only to a landlord who has a live
///                      application from that person, i.e. someone with a
///                      present reason to know. This makes it a reference
///                      rather than a permanent public record following an
///                      individual between lettings, which is both fairer and
///                      a much smaller defamation exposure under South African
///                      law. A tenant can always see their own.
model Review {
  id String @id @default(uuid())

  tenancyId String
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  authorId  String
  author    User    @relation("ReviewsWritten", fields: [authorId], references: [id], onDelete: Cascade)
  /// The person being reviewed. Null for a room review — the subject is the room.
  subjectId String?
  subject   User?   @relation("ReviewsReceived", fields: [subjectId], references: [id], onDelete: SetNull)
  /// Set for room reviews, so a room carries its history across tenancies.
  roomId    String?
  room      Room?   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  type    ReviewType
  /// 1-5. Averaged into LandlordProfile.rating for landlord reviews only.
  rating  Int
  comment String

  /// Withheld until both sides have submitted or the window closes.
  publishedAt DateTime?
  /// The subject's reply. One per review, and it does not affect the rating.
  response    String?
  respondedAt DateTime?

  /// Moderation, for the defamation exposure noted above.
  isHidden     Boolean @default(false)
  hiddenReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One review of each type per author per tenancy.
  @@unique([tenancyId, authorId, type])
  @@index([roomId, publishedAt])
  @@index([subjectId, publishedAt])
  @@map("reviews")
}

enum ReviewType {
  room // tenant -> the room and house
  landlord // tenant -> the landlord's conduct
  tenant // landlord -> the tenant
}

/// A room a tenant has saved with the heart button.
///
/// Server-side rather than localStorage. The device-local version could not be
/// told when a saved room was let — the server had no idea who had saved what —
/// so a tenant would return to a dashboard that had silently dropped the room
/// they were deciding on. It also means saves follow the account across
/// devices, which is what people expect.
model SavedRoom {
  id       String @id @default(uuid())
  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomId   String
  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// Set when the room stops being available, so the tenant can be told once
  /// and the entry can stay visible as "no longer available" rather than
  /// vanishing without explanation.
  notifiedUnavailableAt DateTime?

  createdAt DateTime @default(now())

  @@unique([tenantId, roomId])
  @@index([roomId])
  @@map("saved_rooms")
}

/// Every email the platform attempts to send.
///
/// Exists for three reasons: a landlord asking "did you tell me about that
/// application?" needs an answer; bounces and complaints have to be acted on
/// or the sending domain's reputation degrades and legitimate mail stops
/// arriving; and POPIA s.69 requires being able to show that marketing was
/// consented to and that opt-outs were honoured.
model EmailLog {
  id String @id @default(uuid())

  /// Null when sent to an address with no account (e.g. an anonymous reporter).
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail String

  template String /// e.g. 'new_application', 'password_reset'
  category EmailCategory
  subject  String

  status     EmailStatus @default(queued)
  /// Resend's message id, so a delivery event can be matched back.
  providerId String?     @unique
  error      String?

  sentAt       DateTime?
  deliveredAt  DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([toEmail])
  @@index([status])
  @@map("email_logs")
}

/// Transactional mail is part of the service and is not opt-out-able: someone
/// who applied for a room must be told the outcome. Marketing is, and must be.
enum EmailCategory {
  transactional
  marketing
}

enum EmailStatus {
  queued
  sent
  delivered
  bounced
  complained
  failed
  suppressed // not attempted: the address is on the suppression list
}

/// Addresses that must not be emailed again.
///
/// A hard bounce means the address does not exist; a complaint means someone
/// pressed "spam". Continuing to send to either is how a sending domain gets
/// blacklisted, at which point password resets stop arriving for everyone.
model EmailSuppression {
  id        String            @id @default(uuid())
  email     String            @unique
  reason    SuppressionReason
  detail    String?
  createdAt DateTime          @default(now())

  @@map("email_suppressions")
}

enum SuppressionReason {
  hard_bounce
  complaint
  unsubscribed
  manual
}

/// A payment attempt. Currently only the once-off verification fee, but kept
/// generic because room boosts will need the same shape.
///
/// The ITN webhook is the source of truth, not the browser return: a user who
/// closes the tab after paying must still get what they paid for.
model Payment {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose     PaymentPurpose
  /// What this paid for, e.g. a VerificationRequest id.
  referenceId String?

  /// ZAR cents, to match every other monetary value in the schema.
  amountCents Int
  status      PaymentStatus @default(pending)

  provider          String  @default("payfast")
  /// Our reference, sent as m_payment_id and echoed back by the ITN.
  merchantReference String  @unique
  /// PayFast's pf_payment_id, only known once they confirm.
  providerReference String?

  /// The raw ITN payload, kept for dispute resolution. PayFast does not send
  /// card numbers, so there is nothing sensitive here to avoid storing.
  itnPayload Json?

  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?

  /// Set the moment a paid check is rejected. The pricing page promises a
  /// refund if we cannot verify someone, and a promise that depends on an
  /// admin remembering is not a promise — this is the obligation, recorded
  /// automatically, and `refundedAt` below is the money actually moving.
  ///
  /// Separate from `status` on purpose. Status stays `paid` until the refund
  /// is issued, because that is the truth about where the money is; mixing
  /// the two would make the payment history lie for as long as the refund
  /// takes. Paid + refundDueAt set + refundedAt null is the admin queue.
  refundDueAt DateTime?

  /// Set when a refund is issued — the pricing page promises one if
  /// verification fails, so this must be recordable.
  refundedAt   DateTime?
  refundReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  /// The refunds-due queue: every paid check we rejected and have not yet
  /// refunded. Indexed because it is read on every admin dashboard load.
  @@index([refundDueAt, refundedAt])
  @@map("payments")
}

enum PaymentPurpose {
  landlord_verification
  room_boost
}

enum PaymentStatus {
  pending // created, user sent to PayFast
  paid // ITN confirmed and validated
  failed
  cancelled // user backed out
  refunded
}

/// A business buying placement on the board.
model Advertiser {
  id           String  @id @default(uuid())
  companyName  String
  contactName  String
  contactEmail String
  contactPhone String?
  /// Free text: agency, invoicing reference, who introduced them.
  notes        String?
  isActive     Boolean @default(true)

  campaigns AdCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("advertisers")
}

/// A bought placement.
///
/// TARGETING IS CONTEXTUAL ONLY — province, city, room type. It matches the
/// page being viewed, never the person viewing it. No behavioural profile is
/// built and no personal information is disclosed to an advertiser, which is
/// what keeps this outside POPIA s.69 and lets the platform keep saying it
/// runs no third-party trackers.
model AdCampaign {
  id           String     @id @default(uuid())
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  name      String
  placement AdPlacement

  // Creative
  headline  String
  body      String?
  /// ImageKit path. Optional — text-only ads perform fine in a sidebar.
  imagePath String?
  ctaLabel  String  @default("Learn more")
  targetUrl String

  // Contextual targeting. Null means "any". Most specific wins.
  province   String?
  city       String?
  /// Suburb slug from Place. Narrower than city, and the reason the taxonomy
  /// exists — "sandton" must not be served across all of Johannesburg.
  suburbSlug String?
  roomType   RoomType?

  startsAt         DateTime
  endsAt           DateTime
  /// Flat monthly rate in ZAR cents. Impressions-based pricing is not credible
  /// until there is volume to report honestly.
  monthlyRateCents Int

  status          AdStatus  @default(draft)
  /// Creatives are reviewed before going live: a scam ad on a rental platform
  /// does more damage than the placement is worth.
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  /// Aggregate counters only. Deliberately not per-user rows — knowing which
  /// tenant saw which ad is information we have no need for, and s.10
  /// minimality says do not collect it.
  impressions Int @default(0)
  clicks      Int @default(0)

  /// Mastande's own advert, not a sold placement.
  ///
  /// Fills a slot no paying advertiser matched, so empty inventory promotes
  /// the site rather than showing nothing. Excluded from revenue reporting,
  /// and served only after every paid campaign has been considered — a house
  /// ad must never displace a placement someone paid for.
  isHouseAd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([placement, status])
  @@map("ad_campaigns")
}

/// An inbound enquiry from a business wanting to buy placement.
///
/// Campaigns are created by an admin after a conversation and an invoice, so
/// this is the front door: without it, an advertiser who lands on the site has
/// no way to reach us and the inventory never sells.
model AdEnquiry {
  id           String  @id @default(uuid())
  companyName  String
  contactName  String
  contactEmail String
  contactPhone String?
  /// What they sell, roughly — helps judge fit before replying.
  industry     String?
  /// Free text: budget, placements of interest, timing.
  message      String
  /// Contextual interest, so the reply can quote the right rate.
  province     String?

  status     EnquiryStatus @default(new)
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("ad_enquiries")
}

enum EnquiryStatus {
  new
  contacted
  won
  lost
}

/// Suburb → city → province, so targeting and search can work at the level
/// people actually think in.
///
/// Exists because string matching cannot know that Sandton is in Johannesburg.
/// An advertiser paying for "Sandton" must not silently get the whole of
/// Gauteng, and a tenant searching "Sandton" should still see rooms tagged
/// "Johannesburg" nearby.
///
/// Seeded from a fixed list rather than an API: the set changes rarely, and a
/// runtime dependency on a geocoder would put ad serving behind a third party.
model Place {
  id String @id @default(uuid())

  /// Lowercased, no punctuation — the key everything matches on.
  slug String    @unique
  name String
  type PlaceType

  /// Null for a province. A suburb points at its city; a city at its province.
  parentId String?
  parent   Place?  @relation("PlaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Place[] @relation("PlaceHierarchy")

  /// Denormalised for querying without recursion — a suburb carries both.
  city     String?
  province String

  /// Common alternates: "PE" for Gqeberha, "Joburg" for Johannesburg.
  aliases String[] @default([])

  createdAt DateTime @default(now())

  @@index([type, province])
  @@index([city])
  @@map("places")
}

/// Aggregate UX counters. NOT per-user analytics.
///
/// One row per event per day, incremented. There is deliberately no user id,
/// no session id, no IP and no timestamp beyond the date — which means this
/// cannot be used to reconstruct one person's journey, by us or by anyone who
/// obtained the database.
///
/// That is a real limitation: it answers "how many people abandoned the wizard
/// at step 3" but never "did THIS person abandon it". For product decisions the
/// first question is the one that matters, and the second is the one that turns
/// a room board into a surveillance platform.
model UxCounter {
  id String @id @default(uuid())

  /// Dotted event name, e.g. 'wizard.step2_reached'.
  event   String
  /// Low-cardinality dimension: 'mobile', 'desktop', or 'all'. Never anything
  /// that could identify a person.
  ///
  /// NOT nullable, deliberately. Postgres treats NULL as distinct from NULL in
  /// a unique index, so a nullable column here would let the same event/day
  /// insert unlimited duplicate rows and the counter would never increment.
  segment String   @default("all")
  /// Date only. An exact timestamp plus a rare event is identifying.
  day     DateTime @db.Date

  count Int @default(0)

  @@unique([event, segment, day])
  @@index([event, day])
  @@map("ux_counters")
}

enum PlaceType {
  province
  city
  suburb
}

enum AdPlacement {
  board_sidebar // under the filter panel
  board_inline // between room cards in the grid
  room_detail // below a listing
}

enum AdStatus {
  draft
  pending_review
  active
  paused
  rejected
  ended
}

/// A shareable code that credits whoever brought a new user in.
///
/// Two kinds, and the distinction matters:
///   user   — generated for a landlord or tenant to share. Unlimited uses.
///   launch — seeded per city for the launch push, handed out by us to early
///            landlords. Capped uses, so a code cannot leak and be farmed.
model ReferralCode {
  id   String @id @default(uuid())
  code String @unique

  type    ReferralCodeType @default(user)
  /// Null for launch codes — nobody personally earns those.
  ownerId String?
  owner   User?            @relation("ReferralCodesOwned", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Launch codes are scoped to where we are pushing, so redemptions can be
  /// attributed to a city rather than a person.
  city     String?
  province String?

  /// Null means unlimited, which is right for a user's own code.
  maxUses   Int?
  useCount  Int       @default(0)
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  referrals Referral[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@index([city])
  @@map("referral_codes")
}

enum ReferralCodeType {
  user
  launch
}

/// One person arriving via a code.
///
/// Deliberately not counted at signup. A referral qualifies when the new user
/// does the thing that makes them worth referring — a landlord publishes a
/// room, a tenant submits an application. Rewarding signups alone is how a
/// referral scheme fills up with abandoned accounts.
model Referral {
  id String @id @default(uuid())

  codeId String
  code   ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  /// Null when the referral came from a launch code.
  referrerId String?
  referrer   User?   @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: SetNull)

  refereeId String @unique
  referee   User   @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Cascade)

  status           ReferralStatus @default(pending)
  /// What the referee did to qualify, e.g. 'published_room', 'applied'.
  qualifyingAction String?
  qualifiedAt      DateTime?

  /// What the referrer earned. Kept explicit rather than implied, because the
  /// reward has to be honoured and audited.
  reward       ReferralReward @default(none)
  rewardedAt   DateTime?
  /// Set when a free-verification reward is spent, so it cannot be reused.
  rewardUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([referrerId, status])
  @@index([status])
  @@map("referrals")
}

enum ReferralStatus {
  pending // signed up, has not done the qualifying action yet
  qualified // did it — the referrer has earned the reward
  rewarded // reward granted
  void // self-referral, duplicate, or abuse
}

enum ReferralReward {
  none // tenants: no monetary reward, and the UI says so
  free_verification // landlords: covers the R149 identity check
}

enum AuthTokenType {
  password_reset
  email_change
  /// Passwordless sign-in. Single use, 15 minutes.
  magic_link
  /// One-time code sent to a verified phone, over WhatsApp or SMS.
  phone_otp
  /// Proving a NEW number before it replaces the one on the account — Phase 7o.
  phone_change
}

enum AlertFrequency {
  instant
  daily
  off
}

enum VerificationType {
  identity // SA ID book/card or passport
  proof_of_address // utility bill, municipal statement
  proof_of_ownership // title deed, or a mandate to let

  // ── Tenant income proofs (v1.56.0) ──
  //
  // Deliberately NOT a credit check. A bureau record requires a credit
  // history, and most of this market does not have one — the people who most
  // need to prove they can pay are precisely the ones a bureau cannot see.
  // Screening on it would exclude them while telling the landlord nothing
  // about whether rent arrives.
  //
  // Each of these is a document a real South African tenant already has.

  /// SASSA grant payment confirmation. A grant is income: it arrives monthly,
  /// on a known date, at a known amount, and it is more predictable than most
  /// wages in this market.
  sassa_grant
  /// A letter, WhatsApp message or SMS from an employer confirming the job and
  /// the pay. Informal employment rarely produces a payslip.
  employer_confirmation
  /// Banking app screenshots, three months, showing money coming in.
  bank_statement
  /// A prior landlord, named and phoned. See the LandlordReference model —
  /// this one is not a document at all.
  landlord_reference

  // ── Sub-letting (v1.86.0, Phase 6) ──

  /// A sub-lessor's right to let out a room in a place they rent: the lease
  /// itself, plus either a clause permitting subletting or the head landlord's
  /// written consent.
  ///
  /// Distinct from `proof_of_ownership`, and not a variant of it. That check
  /// asks "do you own this, or hold a mandate from the owner"; this one asks
  /// "are you allowed to pass on what you rent", which is a different document
  /// from a different person with a different failure mode — and the person who
  /// loses if it is wrong is the applicant, not us.
  ///
  /// ⚠️ Carries NO FEE, and that is a positioning decision rather than an
  /// oversight. A sub-lessor is listing a room, and listing is free — charging
  /// them to prove they may sublet would be a landlord listing fee by another
  /// name, which is the one thing this product does not do.
  ///
  /// Scoped to one listing: see `VerificationRequest.roomId`.
  sublet_right
}

/// Who performed a step in a verification's history.
enum VerificationActor {
  /// The person being verified — submitting, re-submitting, withdrawing.
  applicant
  /// A named admin. `VerificationEvent.actorId` says which.
  admin
  /// An automated step: payment confirmed, reference reply received, expiry.
  system
}

enum VerificationStatus {
  /// Document uploaded, fee not yet paid. Not visible in the admin queue —
  /// reviewing before payment means chasing money from someone you just
  /// told no.
  pending_payment
  pending
  approved
  rejected
}

/// A tenant's standing search. Matched against each newly published room so
/// tenants hear about a room while it is still available — most rooms are let
/// within days, so a tenant who only checks weekly misses nearly everything.
model SavedSearch {
  id       String @id @default(uuid())
  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Shown in the dashboard, e.g. "En-suite in Sandton under R6000"
  name String

  // Filter criteria — all optional; null means "no constraint on this field".
  province          String?
  city              String?
  roomType          RoomType?
  maxRentCents      Int?
  minRentCents      Int?
  billsIncluded     Boolean?
  couplesAllowed    Boolean?
  dssAccepted       Boolean?
  guarantorAccepted Boolean?
  petsAllowed       Boolean?

  frequency      AlertFrequency @default(instant)
  /// POPIA s.11(1)(a): alerts are direct marketing, so consent is explicit and
  /// withdrawable. Pausing sets this false rather than deleting the search.
  isActive       Boolean        @default(true)
  notifyEmail    Boolean        @default(true)
  notifyWhatsapp Boolean        @default(false)

  lastNotifiedAt DateTime?
  matchCount     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([isActive, province])
  @@map("saved_searches")
}

/// A landlord's submitted verification document.
///
/// POPIA: an ID number and ID document are "special personal information"
/// (s.26). Documents are stored privately in ImageKit (isPrivateFile), are
/// never exposed on a public room card, are visible only to the submitting
/// landlord and an admin reviewer, and are deleted once a decision is made —
/// only the outcome is retained. See docs/VERIFICATION.md.
model VerificationRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   VerificationType
  status VerificationStatus @default(pending)

  /// Private ImageKit path. Cleared when the request is decided.
  documentPath        String?
  /// When the document stopped being reachable through this API — set as the
  /// decision clears `documentPath`.
  ///
  /// Called `documentDeletedAt` until v1.83.0, which was a false name: nothing
  /// deleted anything. The bytes stayed on ImageKit while this column, an audit
  /// event, the privacy policy and the PAIA manual all said they were gone.
  ///
  /// It is `withdrawn` now because that is the promise this timestamp can
  /// actually keep, and it is kept in the same transaction as the decision. The
  /// stronger claim — that the file itself is gone — lives on
  /// `FileDeletion.deletedAt`, set from ImageKit's own response. Two promises,
  /// two columns, neither standing in for the other.
  documentWithdrawnAt DateTime?

  /// The listing this check is about — set only for `sublet_right`, where the
  /// question is address-specific (one lease, one house). Null for every other
  /// type, which is about the person.
  ///
  /// `SetNull` rather than `Cascade`, for the same reason an Expense survives
  /// its room: deleting a listing must not erase the record that a document was
  /// checked and by whom. The row stays as audit; it simply stops evidencing
  /// anything about a live listing, which is correct, because there is none.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  reviewedById String?
  reviewedAt   DateTime?
  /// Shown to the landlord on rejection so they know what to fix.
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every step this request went through. The reason a badge can show its
  /// working rather than being a bare boolean — see VerificationEvent.
  events    VerificationEvent[]
  /// Set only when type is `landlord_reference`.
  reference LandlordReference?

  @@index([userId])
  @@index([status])
  @@index([roomId])
  @@map("verification_requests")
}

/// One step in a verification's history: what was checked, when, by whom.
///
/// Exists because `idVerified = true` is not evidence of anything. A tenant
/// asked to trust a badge, or a landlord asked to trust a Passport, can be
/// shown what was actually checked and when — and if a decision is ever
/// disputed, there is a record of who made it.
///
/// POPIA s.10: the trail records that a document was checked, never what the
/// document said. `detail` is a description ("SASSA confirmation letter, name
/// matched the account") and must never carry an ID number, a bank balance or
/// a grant reference. The document itself is still deleted on decision — this
/// outlives it on purpose, because the outcome is what the badge rests on.
model VerificationEvent {
  id        String              @id @default(uuid())
  requestId String
  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  actor   VerificationActor
  /// The admin's user id when actor is `admin`. Null otherwise. Not a relation
  /// on purpose: an admin account being deleted must not cascade away the
  /// history of decisions they made.
  actorId String?

  /// Machine-readable step name, e.g. `submitted`, `payment_received`,
  /// `document_checked`, `reference_sent`, `approved`, `document_deleted`.
  step   String
  /// Human-readable, shown to the subject. Never the personal information.
  detail String?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@map("verification_events")
}

enum ReferenceStatus {
  /// Submitted by the tenant, nobody has contacted the referee yet.
  awaiting_contact
  /// A confirmation request went out over WhatsApp, or an admin phoned.
  contacted
  /// The referee confirmed the tenancy.
  confirmed
  /// The referee disputed it, or declined to confirm.
  disputed
  /// Contacted, no response before the token expired. Not a negative signal.
  unreachable
}

/// A prior landlord, named by the tenant and asked to confirm.
///
/// The one check here that is not a document, and the most useful: in a market
/// where income is informal, "they paid me on time for eighteen months" is
/// better evidence than a bank statement.
///
/// The referee has no account and never will — asking a previous landlord to
/// sign up in order to answer one question is how a reference never arrives.
/// They answer through a one-time link delivered over WhatsApp, or an admin
/// phones them and records the outcome. Either way the result lands here.
///
/// POPIA: the referee's name and number are personal information belonging to
/// a third party, supplied by the tenant under s.11(1)(a) consent captured at
/// submission. They are used once, for this purpose, and deleted with the
/// request. The referee is told who is asking and why in the first message.
model LandlordReference {
  id        String              @id @default(uuid())
  requestId String              @unique
  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// Supplied by the tenant.
  refereeName         String
  refereePhone        String
  /// "Room in Ext 7, Tembisa" — enough for the referee to recognise which
  /// tenancy is being asked about, without an address we have no need for.
  propertyDescription String?
  tenancyStartedAt    DateTime?
  tenancyEndedAt      DateTime?

  status  ReferenceStatus @default(awaiting_contact)
  /// 1–5, set by the referee. Null until they answer.
  rating  Int?
  /// The referee's own words, sanitised. Optional.
  comment String?

  /// sha256 of the one-time token in the confirmation link. The token itself
  /// is never stored, for the same reason the refresh token is not: a leaked
  /// database must not let anyone answer a reference as the referee.
  responseTokenHash String?   @unique
  tokenExpiresAt    DateTime?

  contactedAt DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("landlord_references")
}

enum MessageChannel {
  /// Sent through the site itself. Named for the channel rather than the
  /// brand: this value was `rentboard`, so renaming the product meant a
  /// database migration. It will not need one again.
  in_app
  whatsapp
}

/// A single message within an application's conversation thread.
/// WhatsApp-originated messages carry waMessageId for delivery-status webhooks.
model Message {
  id            String         @id @default(uuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  channel       MessageChannel @default(in_app)
  body          String
  waMessageId   String?        @unique
  waStatus      String?
  readAt        DateTime?
  createdAt     DateTime       @default(now())

  @@index([applicationId])
  @@index([waMessageId])
  @@map("messages")
}

/// Per-landlord WhatsApp Business API opt-in — one landlord notification
/// channel, separate from the in-app conversation thread.
model LandlordWhatsappConfig {
  id                String          @id @default(uuid())
  landlordId        String          @unique
  landlord          LandlordProfile @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  phoneNumber       String
  phoneVerified     Boolean         @default(false)
  waEnabled         Boolean         @default(true)
  optInAt           DateTime        @default(now())
  totalMessagesSent Int             @default(0)

  @@map("landlord_whatsapp_configs")
}

enum PassportStatus {
  pending
  active
  expired
  cancelled
}

/// Refresh tokens — opaque random values, only ever stored HASHED (sha256).
/// Rotated on every use: presenting a token revokes it and issues a new one.
/// If a REVOKED token is ever presented again, that's a signal of theft
/// (someone replayed an old value) — AuthService responds by revoking every
/// token for that user, forcing a full re-login. See README §20.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// What went wrong. Phrased from the reporting party's side and kept short:
/// a long list invites mis-selection, and the detail field carries the rest.
enum TenancyFlagReason {
  // Raised by a landlord, about a tenant
  unpaid_rent
  property_damage
  left_without_notice
  // Raised by a tenant, about a landlord
  deposit_withheld
  room_not_as_described
  unlawful_entry_or_eviction
  // Either
  harassment
  other
}

enum TenancyFlagStatus {
  /// Raised, awaiting admin review. Reduces visibility while open.
  open
  /// Admin agreed with the flag. Stays counted against the account.
  upheld
  /// Admin did not. Stops counting immediately.
  dismissed
  /// The person who raised it took it back.
  withdrawn
}

/// A problem raised after a tenancy ended.
///
/// Reviews already exist, but a review is a public rating and opens only for
/// 30 days. This is a different thing: a private report to the platform that
/// someone behaved badly, which an admin acts on. The two must not be
/// conflated — a landlord who withheld a deposit should not be answerable
/// only through a star rating.
///
/// **Reduced visibility, not suspension.** An open flag lowers a landlord's
/// rooms on the board and marks the account in the admin queue. It does not
/// hide listings, close applications or touch anyone's existing tenancy.
/// A flag is an untested allegation until an admin reads it, and one angry
/// party must not be able to take another's livelihood off the board by
/// filling in a form. Suspension already exists, is reversible, and is an
/// admin decision.
///
/// Defamation is the reason this is not public. Publishing "this landlord
/// withheld my deposit" against a named individual, unreviewed, is the
/// platform's largest legal exposure in South Africa — the same reasoning
/// that keeps a landlord's review of a tenant a private reference rather than
/// a public record.
model TenancyFlag {
  id String @id @default(uuid())

  tenancyId String
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  /// Who raised it.
  raisedById String
  raisedBy   User   @relation("FlagsRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  /// Who it is about — the other party to the same tenancy, derived at
  /// creation rather than supplied, so nobody can flag a stranger.
  againstId  String
  against    User   @relation("FlagsAgainst", fields: [againstId], references: [id], onDelete: Cascade)

  reason TenancyFlagReason
  /// The reporting party's account, sanitised. Required — a reason code alone
  /// gives an admin nothing to act on.
  detail String

  status TenancyFlagStatus @default(open)

  reviewedById String?
  reviewedAt   DateTime?
  /// Shown to both parties once reviewed, so a decision is not a silence.
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One flag per party per tenancy. A second problem belongs in the same
  /// report; ten flags from one aggrieved party is not ten signals.
  @@unique([tenancyId, raisedById])
  @@index([againstId, status])
  @@index([status, createdAt])
  @@map("tenancy_flags")
}

/// A yard: several rooms at one place, under one landlord.
///
/// Most landlords in this market are not letting a single spare room. They
/// run a yard — four, six, ten rooms behind one house — and the product has
/// been modelling each of those as an unrelated listing, which is why there
/// was no way to ask "how many of my rooms are empty" or "who has applied
/// anywhere on the property". Neither competitor supports this either.
///
/// Optional on Room. A landlord with one room should never be made to create
/// a container for it first, and every room that existed before this has no
/// property and works exactly as it did.
///
/// **No street address, deliberately.** The obvious field to add here is the
/// address, and POPIA s.10 says collect only what the purpose requires. The
/// yard view needs to tell one property from another, which a name and a
/// suburb already do. An exact address would be new location data about where
/// specific people live, held for nothing that uses it — and a room's public
/// page has always shown the suburb rather than the street for the tenant's
/// safety, so holding the street elsewhere would undercut that.
/// Who already lives at a property, as a shape rather than a list of names.
///
/// The single thing a person sharing a house most wants to know before they
/// apply, and the thing a listing almost never says. It sits on Property, not
/// Room, because it is a fact about the house: four rooms at one address share
/// one answer, and asking a landlord to set it four times guarantees the four
/// disagree.
enum HousemateProfile {
  professionals
  students
  /// Working people and students together, or simply varied. The honest answer
  /// for most shared houses in this market.
  mixed
  couples
  /// The landlord has not said. Distinct from `mixed`, which is a claim —
  /// this is the absence of one, and the room page shows nothing rather than
  /// inventing a description of who a person would be living with.
  unstated
}

model Property {
  id         String @id @default(uuid())
  landlordId String
  landlord   User   @relation("PropertiesOwned", fields: [landlordId], references: [id], onDelete: Cascade)

  /// What the landlord calls it — "Ext 7 house", "Main Road back rooms".
  /// Their own words: they have to recognise it in a list at a glance.
  name     String
  suburb   String?
  city     String
  province String

  /// A street address, for the landlord's eyes only — Phase 7b.
  ///
  /// ── Why this is optional and private, when the brief asked for "full address"
  ///
  /// The Phase 7b brief wants the property card to show the full address under
  /// the nickname, and the reason is sound: "Ext 7 back rooms" and "the other Ext
  /// 7 place" are not distinguishable in a list. But the yard screen has
  /// deliberately never collected a street address, with a stated reason — the
  /// board shows the suburb and not the street, for the tenant's safety, and the
  /// platform has no function that needs one. It does not arrange viewings, hold
  /// deposits or deliver anything.
  ///
  /// So this is the smallest thing that serves the purpose: OPTIONAL, free text,
  /// and never leaving the landlord's own screens. It is not in PUBLIC_ROOM_DETAIL
  /// or in any public payload, and the form says so where the landlord types it.
  /// POPIA s.10 (minimality): the purpose is "so a landlord can tell their own
  /// properties apart", which is why it can be left blank and why nothing else
  /// reads it.
  ///
  /// ⚠️ If a future feature needs a verified address — a municipal check, say —
  /// that is a different field with its own consent, not this one widened.
  addressLine String?

  // ── What the whole address shares ──────────────────────────────────────
  //
  // These are properties of the HOUSE, and they live here rather than on Room
  // for one reason: four rooms at one address have one kitchen, one set of
  // rules and one group of housemates. Held per-room, a landlord has to type
  // them four times and the four copies drift — which is the same defect as
  // the portal nav defined six times, and it would drift in front of tenants
  // deciding where to live.
  //
  // Room keeps what genuinely differs per room: its own rent, its own
  // `amenities` (an en-suite is not shared), its own availability.

  /// House rules in the landlord's own words — "no visitors after 10", "gate
  /// locked at 9". Free text rather than a checklist: the rules that matter in
  /// this market are specific, and a checklist would replace them with the
  /// generic ones that do not.
  houseRules String?

  /// Shared facilities — the kitchen, the tap, the washing line, the gate.
  /// Named `sharedAmenities`, NOT `propertyAmenities`, so it can never be read
  /// as a synonym for `Room.amenities`: one is what everyone at this address
  /// uses, the other is what comes with this room alone.
  sharedAmenities String[]

  /// How many people already live at the address, across all rooms. Null means
  /// not said. Distinct from `Room.housematesCount`, which several rooms may
  /// each answer about their own sharing arrangement.
  currentHousemates Int?

  housemateProfile HousemateProfile @default(unstated)

  // ── Compatibility, for shared houses — Phase 6 ─────────────────────────
  //
  // These matter far more for a sublet than for a backroom: somebody taking a
  // room in a house with four other people is choosing housemates, not just a
  // room, and this is the part every listing on every competitor leaves out.
  // They are filterable on the board.
  //
  // Set for any house, not only sublets — a landlord-owned shared house has a
  // household too — but the sublet listing flow is the only place that asks
  // for them today, because that is where the brief says they belong.
  householdSchedule    HouseholdSchedule    @default(unstated)
  householdCleanliness HouseholdCleanliness @default(unstated)
  householdSocial      HouseholdSocial      @default(unstated)

  rooms    Room[]
  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landlordId])
  @@map("properties")
}

/// Whether one month's rent was paid, as the landlord recorded it.
enum RentStatus {
  unpaid
  paid
  /// Something came in, but not all of it. Common here, and collapsing it
  /// into unpaid would make the reminder wrong and the landlord's own record
  /// useless.
  partial
  /// The landlord is not chasing this one. Stops reminders without lying
  /// about whether money arrived.
  waived
}

/// One month of rent on one tenancy, marked by hand.
///
/// No payment processing. The landlord is already collecting rent by EFT, in
/// cash, or over a banking app, and the thing they do not have is a record of
/// who is behind. A toggle is the whole feature, and inserting Mastande into
/// the money would change what this product is.
///
/// **The platform does not assert that anyone owes anything.** A period is
/// one party's unverified word. That shapes two things: the reminder is
/// phrased as "your landlord has marked this unpaid" rather than "you owe",
/// and `tenantDisputedAt` exists so the other side can say "I paid this" and
/// have it recorded and visible, instead of arguing over a notification they
/// cannot answer.
model RentPeriod {
  id        String  @id @default(uuid())
  tenancyId String
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  /// First day of the month this covers. Normalised to midnight UTC so the
  /// unique constraint below actually holds — two rows for "September"
  /// differing by a timezone offset would defeat it entirely.
  periodStart DateTime

  status      RentStatus @default(unpaid)
  /// Snapshotted from the tenancy, because rent changes and a record of
  /// August must keep saying what August cost.
  amountCents Int

  markedAt   DateTime?
  markedById String?

  /// The tenant's side. Not a status — a landlord's record stays theirs, and
  /// the dispute sits beside it rather than overwriting it.
  tenantDisputedAt DateTime?
  tenantNote       String?

  /// Set when a reminder goes out, so one is never sent twice for the same
  /// month. Nulled if the period is later marked unpaid again.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenancyId, periodStart])
  @@index([status, periodStart])
  @@map("rent_periods")
}

enum WhatsappDraftStatus {
  /// Photos and text still arriving.
  collecting
  /// The landlord said they were done. Waiting for them to open the web and
  /// publish — nothing goes live from WhatsApp alone.
  ready
  /// Turned into a Room draft. `roomId` says which.
  claimed
  /// Nothing for two weeks. Kept, not deleted, so a landlord who comes back
  /// is not told their photos are gone.
  abandoned
}

/// A listing being dictated over WhatsApp.
///
/// Most landlords in this market live on WhatsApp and do not want to fill in
/// a seven-step web wizard on a phone. This lets them send photos and a
/// sentence to a number and have a draft waiting for them.
///
/// **Nothing here ever goes live by itself.** The draft becomes a Room in
/// `draft` status only when the landlord opens the site and claims it, and
/// then still has to pass the ordinary publish rules — a cover photo and a
/// 50-character description. A listing is a commitment to a stranger about
/// somewhere they might live; it does not get published by a parser's guess.
///
/// Held separately from Room rather than creating a Room immediately, because
/// Room requires a type, a rent, a province, a city and an availability date,
/// and a half-finished WhatsApp conversation has none of them. Creating rows
/// that cannot satisfy their own model would mean loosening the model for
/// every other path.
model WhatsappDraft {
  id         String @id @default(uuid())
  landlordId String
  landlord   User   @relation("WhatsappDrafts", fields: [landlordId], references: [id], onDelete: Cascade)

  /// The wa_id the messages came from. Recorded because a landlord may have
  /// more than one number and the reply has to go back to the right one.
  fromNumber String

  status WhatsappDraftStatus @default(collecting)

  /// Everything the landlord typed, in order. Kept raw as well as parsed:
  /// the parser is deliberately simple and a human reading the original is
  /// the fallback when it gets something wrong.
  rawText    String?
  /// ImageKit paths, in the order they arrived. The first becomes the cover.
  imagePaths String[]

  // What the parser made of it. Every one nullable — a missing field is a
  // blank on the review screen, never a guess presented as fact.
  parsedTitle     String?
  parsedRentCents Int?
  parsedRoomType  RoomType?
  parsedProvince  String?
  parsedCity      String?
  parsedSuburb    String?

  /// Set once claimed.
  roomId String? @unique

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([landlordId, status])
  @@index([status, lastMessageAt])
  @@map("whatsapp_drafts")
}

/// Where a response came from. Kept because the three surfaces do not measure
/// the same thing: the micro-survey catches someone at the moment a room is
/// let, the dashboard catches someone with time to think, and WhatsApp reaches
/// a landlord who does not open the portal at all — which is exactly the
/// segment whose answers the product knows least about. Pooling them would
/// hide that difference in the aggregate.
enum SurveySource {
  micro
  dashboard
  whatsapp
}

/// A questionnaire. One row per survey, questions carried as JSON.
///
/// Deliberately NOT a form builder. The questions are authored in
/// prisma/surveys.ts and seeded; this model is general enough that a second
/// survey is a hand-written seed entry rather than a schema change, and no
/// further than that. A generic builder is a product in its own right and
/// nobody has asked for one.
///
/// `questions` is an array of objects, each:
///   { id: string, prompt: string, kind: 'choice' | 'text',
///     options?: string[], optionalText?: boolean }
///
/// `id` is what answers are keyed by and must never be reused or renumbered —
/// responses already collected point at it. Reordering the array is safe;
/// changing an id silently reinterprets every answer already given.
model Survey {
  id    String @id @default(uuid())
  /// Stable handle used by the code that triggers it (e.g. 'landlord-pain-2026').
  slug  String @unique
  title String

  /// Shown above the first question. Plain English, like everything else.
  intro String?

  questions Json

  /// Who should see it, as a filter the server applies — never trusted from
  /// the client. Shape: { role: 'LANDLORD', minRooms?: number }.
  /// A survey nobody matches is not an error; it simply never shows.
  audience Json

  /// Off by default. A half-written survey that is live by accident is worse
  /// than one nobody can find.
  active Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses  SurveyResponse[]
  dismissals SurveyDismissal[]

  @@map("surveys")
}

/// One person's answers.
///
/// `landlordProfileId` is nullable because the brief allows triggering before
/// sign-in. An anonymous response still counts in the aggregate; it simply
/// cannot be segmented by room count, and the admin view says so rather than
/// quietly dropping it.
///
/// POPIA: answers are opinions about the product, not personal information,
/// and nothing here stores a name or a number. The link to a landlord exists
/// so the same person is not asked twice and so question 3 can segment the
/// rest — not so answers can be read back against an individual. The admin
/// view aggregates and never shows who said what.
model SurveyResponse {
  id       String @id @default(uuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  landlordProfileId String?

  source SurveySource

  /// Keyed by question id: { q1: 'Facebook', q5: { choice: 'yes', text: '…' } }.
  /// Partial by design — someone who answers two questions and stops has told
  /// us something, and discarding it to insist on a complete set would bias
  /// the result toward people with time.
  answers Json

  createdAt DateTime @default(now())

  /// One response per landlord per survey. Without this the dashboard prompt
  /// and the WhatsApp message collect the same person twice and the counts
  /// overstate agreement.
  @@unique([surveyId, landlordProfileId])
  @@index([surveyId, source])
  @@map("survey_responses")
}

/// "Not now." Recorded so the prompt can honour it for 30 days.
///
/// Separate from SurveyResponse rather than a status on it, because a
/// dismissal is not a partial answer and must never be counted as one. Asking
/// again after 30 days is the point — a landlord who skips in a busy week may
/// answer in a quiet one — but asking on the next page load is how a prompt
/// becomes something people learn to dismiss without reading.
model SurveyDismissal {
  id       String @id @default(uuid())
  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  landlordProfileId String

  dismissedAt DateTime @default(now())

  @@unique([surveyId, landlordProfileId])
  @@map("survey_dismissals")
}

/// What a landlord spends on a property.
///
/// The categories are the ones that actually appear on a South African
/// landlord's bank statement for a let property, not a generic accounting
/// chart. `municipal` covers the consolidated bill many municipalities issue;
/// water and electricity are separate because prepaid meters are bought
/// separately from it and a landlord thinks of them separately.
enum ExpenseCategory {
  municipal
  water
  electricity
  maintenance
  other
}

/// One thing the landlord paid for.
///
/// Why this is the feature most likely to bring someone back: a landlord with
/// no vacancy and no rent due has no reason to open the app, and every
/// competitor in this market is a listing portal you visit only when a room is
/// empty. Recording the geyser repair is a reason to be here on the other 340
/// days.
///
/// ── Shape
///
/// It hangs off the PROPERTY, because that is how the money is actually spent:
/// one municipal bill, one plumber, one gate motor for the whole address.
/// `roomId` narrows it when a cost genuinely belongs to one room — a geyser in
/// room 3 — and stays null otherwise. Forcing every expense onto a room would
/// make the common case a lie.
///
/// ── Deliberately NOT built here
///
/// Nothing in this model assumes a single payer, and nothing stores a share.
/// Phase 6 wants co-tenants splitting a bill between them, and the way to not
/// block that is to keep the expense a record of a COST and let any future
/// split be its own table pointing here — rather than adding `paidBy` or
/// `sharePercent` now and guessing at semantics nobody has specified. See
/// docs/FLOW-AUDIT.md §5.7.
///
/// ── POPIA
///
/// A receipt is the landlord's own business record, not information about a
/// tenant, so unlike a verification document it is kept rather than deleted on
/// a decision — a landlord needs it at tax time. It is never shown to anyone
/// but its owner, and no tenant is named on an expense.
model Expense {
  id String @id @default(uuid())

  /// Denormalised from the property so a landlord's own expenses can be read
  /// and authorised without a join on every request.
  landlordId String
  landlord   User   @relation("ExpensesRecorded", fields: [landlordId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Set only when the cost belongs to one room rather than the address.
  /// SetNull rather than Cascade: deleting a listing must not erase what the
  /// landlord spent on it, which they still need at tax time.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  category    ExpenseCategory
  /// ZAR cents, like every other amount in this schema.
  amountCents Int

  /// The day the money went out, which is not the day it was typed in. A
  /// landlord catching up on a month of receipts needs the real dates or the
  /// monthly totals are wrong.
  incurredOn DateTime

  /// ImageKit path, uploaded straight from the browser like every other image
  /// here. Optional: most of this market pays cash and has no receipt.
  receiptPath String?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landlordId, incurredOn])
  @@index([propertyId, incurredOn])
  @@map("expenses")
}

/// The trades a landlord in this market actually calls.
///
/// Short on purpose. A long list would be a taxonomy nobody maintains; these
/// are the five that come up when a room is let and something breaks.
enum ServiceCategory {
  plumber
  electrician
  locksmith
  cleaner
  other
}

/// Someone a landlord can phone when something breaks.
///
/// ── Admin-curated, deliberately
///
/// There is no landlord-facing way to add one, and that is the whole design. An
/// open directory of tradespeople is a directory of whoever registered fastest,
/// and recommending a stranger to someone's tenants is a reputational risk this
/// platform would be taking on with no way to manage it. An admin adds a name
/// or it is not here.
///
/// ── No booking, no payment, no money
///
/// The product's job ends at "here is the number". Tap to call or to open
/// WhatsApp, and the landlord and the plumber arrange it between themselves.
/// Taking a booking would make Mastande a party to the job; taking a payment
/// would put it in the money, which Phase 4 is explicitly scoped to avoid.
///
/// ── sponsoredUntil
///
/// Unused in v1 and present anyway, because it costs one nullable column now
/// and a migration later. A paid placement in a directory landlords open when
/// something is broken is a plausible revenue line that charges an ADVERTISER,
/// not a landlord — so it does not touch "free to list, free to apply". Nothing
/// reads it, and the ordering code says so where it would be read.
///
/// ⚠️ It was also WRITABLE until Phase 7m, which is a different and worse
/// thing. Both DTOs accepted it with `@IsISO8601()` and no other rule, so
/// `PATCH /api/services/admin/:id {"sponsoredUntil": …}` returned 200, echoed
/// the date back and stored it — any date, 1999 included — while nothing acted
/// on it. An admin could sell a placement and be told it had worked. It is off
/// both DTOs now and a write fails with a 400, existing values were cleared as
/// residue, and the column is no longer in the landlord payload either.
model ServiceProvider {
  id String @id @default(uuid())

  category ServiceCategory
  name     String

  /// E.164, so `tel:` and `wa.me` links can be built without guessing.
  /// Stored normalised because a number typed as 082 123 4567 and the same
  /// number as +27821234567 are one tradesperson, and a directory that lists
  /// them twice is a directory nobody trusts.
  phone String

  /// Whether this number is on WhatsApp. Not assumed from the number: most
  /// South African mobiles are, and a wa.me link to one that is not lands the
  /// landlord on an error page blaming them.
  whatsapp Boolean @default(true)

  /// Suburbs or towns they cover, in the landlord's words — "Tembisa",
  /// "Soweto", "Johannesburg South". Free text rather than a Place relation:
  /// a plumber's coverage is not a gazetteer entry and does not need to be.
  areas String[]

  note String?

  /// Off by default. A half-entered provider that is live by accident is worse
  /// than one nobody can find — the same reasoning as Survey.active.
  ///
  /// ⚠️ Cannot be set true without `phoneConfirmedAt` — see below.
  active Boolean @default(false)

  // ── What was actually checked — Phase 7j ─────────────────────────────────
  //
  // ⚠️ The screen claimed this before any of it existed.
  //
  // /landlord/services opened with "People we have checked out and can pass
  // on", and its empty state read "It is names we have checked, not an open
  // directory". Nothing on this model recorded a check of any kind. The page
  // made a trust claim the data could not support — on the one axis this
  // product competes on — and the claim was the only thing a landlord had to
  // go on when deciding whether to let a stranger into their tenant's room.
  //
  // So: dated outcomes, named individually, and the screen states exactly
  // which ones are present rather than asserting "checked". A blanket claim is
  // unfalsifiable; "rang the number on 3 Oct" is not.
  //
  // ── Timestamps rather than booleans
  //
  // A check has a date or it is a rumour. "We verified them" with no date is
  // worth nothing two years later, and a landlord deciding today should be able
  // to see that the reference call was in 2024.

  /// We rang this number and reached this person. The minimum bar for being
  /// listed at all: `active` cannot be true without it.
  phoneConfirmedAt DateTime?

  /// We were shown an identity document. **Only the outcome persists** — the
  /// document itself is never stored, following the VerificationRequest
  /// pattern (POPIA s.19, and minimality: the outcome is what anybody needs).
  idCheckedAt DateTime?

  /// We spoke to a landlord this person has worked for.
  referenceCheckedAt DateTime?

  /// A trade registration, as the body issues it — "PIRB P12345" for a plumber,
  /// a Department of Labour number for an electrician who can issue a CoC.
  ///
  /// Free text and nullable on purpose: the bodies differ per trade, several
  /// trades have none, and an enum here would force an admin to either lie or
  /// leave it blank. Shown verbatim so a landlord can check it themselves,
  /// which is the only thing that makes it worth storing.
  tradeRegistration String?

  /// When the checks were last revisited, and by whom. The admin id is for
  /// accountability and is **never** in a landlord-facing payload.
  lastCheckedAt   DateTime?
  checkedByAdminId String?

  // ── Lead fees — Phase 7k ────────────────────────────────────────────────
  //
  // ⚠️ A contractor is NOT a user. No userId, no email, no password — a name,
  // a phone number and the areas they cover. They cannot sign in, cannot see a
  // bill, cannot accept terms and cannot dispute a charge inside this product.
  //
  // That decides the whole architecture: the platform can keep the RECORD of
  // leads it sent and what they would come to at the agreed rate, and it
  // cannot bill anybody. Collecting would need contractor accounts first — a
  // portal, terms acceptance, a bill they can read and a way to disagree with
  // it — which is a product, not a column.

  /// When this person agreed to pay for leads, recorded by an admin.
  ///
  /// ⚠️ Nothing is counted as billable without it. Charging somebody for leads
  /// they never agreed to receive is not defensible, and they cannot agree
  /// in-product because they have no account — so an admin records that the
  /// conversation happened, the way the closure reason records a request.
  leadFeesAgreedAt DateTime?

  /// What the agreement was, in the admin's words — "agreed R35 a lead on the
  /// phone, 2 Oct". Free text about the AGREEMENT, never about the person.
  leadFeesNote String?

  leads ContractorLead[]

  /// See the note above. Nothing reads this, nothing can write it, and it is
  /// not in any payload. Kept for the revenue line it was reserved for, which
  /// needs a visible "paid placement" label and a contractor who can actually
  /// be billed before it is wired — docs/OUTSTANDING.md §16.
  sponsoredUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active])
  @@map("service_providers")
}

/// Getting back in when the phone itself is gone — Phase 7q.
///
/// ⚠️ The most dangerous path in this product. Read the migration header before
/// changing anything here.
///
/// An account made from a mobile number has no email and no password. Phase 7o
/// made the number changeable with the new one proven first, which covers
/// switching SIMs and covers nothing when the handset is gone: every route needs
/// the old number in hand. This is that case, and the account on the other side
/// holds rooms, applications, tenancies, a rent record and conversations with
/// tenants.
///
/// Two proofs, neither sufficient alone: a PERSON proves identity to an admin
/// offline and the admin records what was checked and when, and the NEW HANDSET
/// answers a code. And the narrowing that matters most — the flow is refused
/// when the account has an email or a password, because then there is a
/// self-service way in and nobody needs to be trusted.
///
/// ⚠️ It cannot warn the real owner in time, and that is stated rather than
/// implied. The notice is written the moment a request opens, to every channel
/// the account has — and in the case this exists for there is no email and the
/// owner cannot sign in to read a Notice. The mitigation is the record, not the
/// warning: permanent, attributable, reconstructable.
///
/// Only outcomes persist: `idSeenNote` is what the admin saw, in their words,
/// and there is deliberately no documentPath — the VerificationRequest rule
/// (POPIA s.19).
model AccountRecovery {
  id String @id @default(uuid())

  userId String
  user   User   @relation("RecoveredAccount", fields: [userId], references: [id], onDelete: Cascade)

  /// Canonical +27. Proven by a code before it replaces anything.
  newPhone String
  /// What the account had when the request opened. The user row will not hold
  /// it afterwards, and an audit that cannot say what was replaced is not one.
  oldPhone String

  status AccountRecoveryStatus @default(open)

  openedByAdminId String?
  openedByAdmin   User?   @relation("RecoveriesOpened", fields: [openedByAdminId], references: [id], onDelete: SetNull)

  /// ⚠️ An approval without this is refused by a CHECK constraint, not only by
  /// the service. Dates rather than booleans: "we verified them" with no date
  /// is worth nothing in a dispute two years later.
  idSeenAt   DateTime?
  /// What was seen, in the admin's words. Never the document itself.
  idSeenNote String?

  /// They answered things only the account's owner could — which rooms, which
  /// tenant, what the rent is. Optional, and worth recording when it happened.
  knowledgeCheckedAt   DateTime?
  knowledgeCheckedNote String?

  approvedByAdminId String?
  approvedByAdmin   User?   @relation("RecoveriesApproved", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?

  refusedAt     DateTime?
  refusedReason String?

  /// HMAC of the code sent to the new number, same scheme as every other code
  /// here. Cleared when spent.
  codeHash      String?
  codeExpiresAt DateTime?
  attempts      Int       @default(0)

  recoveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One live request per account is a PARTIAL unique index in the migration —
  /// Prisma cannot express "unique where status in (…)".
  @@index([status, createdAt])
  @@index([newPhone])
  @@map("account_recoveries")
}

enum AccountRecoveryStatus {
  /// Somebody has asked. Nothing has been checked or moved.
  open
  /// Identity was checked and recorded; a code is on its way to the new number.
  approved
  /// The new handset answered. The account points at it now.
  recovered
  refused
  expired
}

/// Who ended an account, and why — Phase 7i.
///
/// ── Why a row and not a log line
///
/// `setUserActive` records a suspension with `logger.warn`, which is fine for a
/// reversible action on a row that keeps its email. Closure is neither: the
/// email, name and phone number are erased in the same transaction, so after it
/// runs the log line is the ONLY trace that the account ever belonged to
/// anybody — and logs rotate. An operator asked "who closed this account and on
/// whose instruction" six months later needs an answer that is still there.
///
/// It also covers the owner's own closures, so this table is the complete
/// record rather than the admin half of one. One code path writes it, which is
/// the only way the two stay in step.
///
/// ── What it deliberately does NOT hold
///
/// No email, no name, no phone number, no IP. Keeping any of those would retain
/// exactly the personal information the closure existed to erase — an audit
/// trail that defeats the erasure it is auditing. The `userId` is enough: the
/// tombstone row survives, so the id still resolves, and it resolves to
/// "Former member".
///
/// `reason` is free text written by an admin about the REQUEST ("emailed from
/// the registered address", "ticket 412"), never about the person. That is a
/// judgement the admin screen states on the form rather than a rule the
/// database can enforce.
enum AccountClosureActor {
  /// From /account/close, by the person themselves, with their password.
  owner
  /// By an admin, on a request they recorded — a phone-only account with no
  /// password to confirm with, or a POPIA s.24 request made out of band.
  admin
}

model AccountClosure {
  id String @id @default(uuid())

  /// One closure per account. The tombstone is permanent, so this is too.
  userId String @unique
  user   User   @relation("ClosedAccount", fields: [userId], references: [id], onDelete: Cascade)

  actor AccountClosureActor

  /// Null when the owner did it themselves.
  closedByAdminId String?
  closedByAdmin   User?   @relation("ClosuresByAdmin", fields: [closedByAdminId], references: [id], onDelete: SetNull)

  /// Required for an admin closure, absent for the owner's own — their having
  /// typed DELETE on their own account IS the reason.
  reason String?

  createdAt DateTime @default(now())

  @@index([closedByAdminId])
  @@index([createdAt])
  @@map("account_closures")
}

/// What a lead costs, as data rather than as a number in the code — Phase 7k.
///
/// ── Why there is no default anywhere
///
/// The brief said: do not implement arbitrary pricing assumptions, identify
/// where pricing should be configurable. This table IS that answer. There is no
/// price in the source, no fallback, no environment variable holding "3500".
/// Until somebody inserts a rate, leads are recorded with no fee and marked not
/// billable — the product counts what it sent and declines to put a number on
/// it, which is the honest state of a price nobody has decided.
///
/// ── Per category, because a plumber call-out is not a cleaner call-out
///
/// And effective-dated rather than mutable, so changing the price next month
/// cannot re-bill last month. A lead snapshots the rate it was created under;
/// this table is the history of what was agreed, not a single current value.
model ContractorLeadRate {
  id String @id @default(uuid())

  category ServiceCategory

  /// Cents, like every other amount in this schema. Cents only crosses the
  /// wire and the database; rand is a display concern.
  amountCents Int

  /// From when this rate applies. Rates are never edited — a new row supersedes
  /// an older one, and the old one stays because leads point at it.
  effectiveFrom DateTime

  /// Why this number, in the admin's words.
  note String?

  setByAdminId String?

  createdAt DateTime @default(now())

  leads ContractorLead[]

  @@index([category, effectiveFrom])
  @@map("contractor_lead_rates")
}

/// A landlord was handed this contractor's number — Phase 7k.
///
/// ── What a lead is here, and what it is not
///
/// It is a record that we passed a number on. It is NOT a job, not a booking
/// and not a payment: the product's job still ends at the number, and whatever
/// the landlord and the tradesperson agree is between them.
///
/// ── Deduplicated per landlord per day
///
/// A landlord tapping "call" five times while the plumber's phone rings is one
/// lead, not five. The unique index is (provider, landlord, day) — Prisma
/// cannot express an index over an expression, so the day is stored as its own
/// column rather than derived from createdAt.
///
/// ── The landlord's identity, and why it is here
///
/// `room_view_days` stores a count and no viewer identity, deliberately, because
/// a count was all anybody needed. Here identity is load-bearing twice over:
/// deduplication needs to know same-landlord-or-different, and a contractor
/// disputing "you billed me for twelve leads" can only be answered from rows
/// that distinguish twelve landlords from one landlord twelve times.
///
/// It is never disclosed to the contractor — who has no account to see it in —
/// and it is nulled when the landlord closes their account: the lead is a
/// record involving a third party and stays, the person does not.
///
/// ── The fee is snapshotted
///
/// `feeCents` is copied from the rate in force when the lead was recorded, and
/// `rateId` says which. A price change next month must not silently re-price
/// what was already sent.
model ContractorLead {
  id String @id @default(uuid())

  providerId String
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// Null once that landlord has closed their account. The lead survives; the
  /// person does not.
  landlordId String?
  landlord   User?   @relation("ContractorLeads", fields: [landlordId], references: [id], onDelete: SetNull)

  /// Which button the landlord pressed. Worth distinguishing: a WhatsApp tap
  /// and a phone call are different kinds of contact and a contractor who
  /// answers neither is a different problem from one nobody tried.
  channel ContractorLeadChannel

  /// The calendar day, for the dedupe index. UTC midnight.
  leadDay DateTime @db.Date

  /// Copied from the rate in force at the time, or null when no rate was
  /// configured for this category. Null means "we counted it and will not put a
  /// number on it", which is the honest state when no price has been agreed.
  feeCents Int?

  rateId String?
  rate   ContractorLeadRate? @relation(fields: [rateId], references: [id], onDelete: SetNull)

  /// False unless the provider had agreed to lead fees AND a rate existed.
  /// Stored rather than derived, because the answer must not change later when
  /// somebody agrees terms or sets a price.
  billable Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([providerId, landlordId, leadDay])
  @@index([providerId, createdAt])
  @@index([billable, createdAt])
  @@map("contractor_leads")
}

enum ContractorLeadChannel {
  call
  whatsapp
}

/// A landlord inviting an applicant to come and see the room — Phase 7l.
///
/// ── There was no such thing before this
///
/// `ApplicationStatus` runs pending → viewed → shortlisted → accepted, and
/// `viewed` means THE LANDLORD OPENED THE APPLICATION. Nothing in the product
/// recorded a room viewing, so "I will meet you Saturday at four" happened in
/// the message thread and nowhere else: no date anybody could look up, nothing
/// the tenant could answer yes or no to, and nothing that reminded either of
/// them it was happening.
///
/// ── Hung off the application, not off the room and tenant separately
///
/// An application already ties one tenant to one room, carries the letting
/// cycle, and is the thing both sides already have a screen for. Two foreign
/// keys would allow a viewing for a tenant who never applied, which is a
/// stranger being given an address.
///
/// ── The meeting place is TYPED, never pre-filled
///
/// ⚠️ This is the decision that matters most in this model.
///
/// The board shows a suburb, not a street: `Room.locationDisplay` is "Tembisa,
/// Johannesburg" on purpose, for the tenant's safety and the landlord's. And
/// `Property.addressLine` exists but its own form says, in those words, "Only
/// you see this. It is never on a listing and never sent to an applicant."
///
/// So a viewing invitation CANNOT pre-fill from it. Pre-filling would break a
/// promise the product made in writing, on the form where the landlord typed
/// it. The landlord types where to meet, for this viewing, for this person —
/// and the invitation screen says that it goes to them.
///
/// It is the one moment an address is deliberately disclosed, to one named
/// applicant, chosen deliberately. That is what makes it defensible.
model RoomViewing {
  id String @id @default(uuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// When the landlord proposes they meet. Must be in the future when created —
  /// an invitation to a time that has passed is not an invitation.
  startsAt DateTime

  /// Where to meet, in the landlord's own words, for this viewing only. See
  /// the note above: never copied from Property.addressLine.
  meetingPlace String

  /// "Ask for Sipho at the gate." Optional, and the thing that actually gets
  /// somebody through a locked gate.
  note String?

  status ViewingStatus @default(proposed)

  /// The tenant's answer. Only the tenant may set it.
  respondedAt DateTime?

  /// Why they cannot come, if they said. Free text, optional — a tenant who
  /// declines owes nobody a reason, and demanding one would mean they simply
  /// do not answer.
  declineReason String?

  /// Either side may cancel, and who did is worth knowing: a landlord
  /// cancelling twice on somebody is a different thing from a tenant doing it.
  cancelledAt DateTime?
  cancelledById String?
  cancelledBy   User?   @relation("ViewingsCancelled", fields: [cancelledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId, startsAt])
  @@index([startsAt, status])
  @@map("room_viewings")
}

enum ViewingStatus {
  /// The landlord has invited; the tenant has not answered.
  proposed
  /// The tenant said yes.
  accepted
  /// The tenant said no.
  declined
  /// Called off by either side after the fact.
  cancelled
}

/// A file that must be removed from ImageKit, kept until it actually is.
///
/// ── Why this table exists
///
/// It was written because the retention promise was not being kept. Deciding a
/// verification set `documentDeletedAt`, cleared `documentPath`, and wrote an
/// audit event reading *"The uploaded document was deleted."* — and nothing
/// anywhere in this codebase had ever called ImageKit's delete API. `grep` for
/// it returned nothing; there is no ImageKit SDK in package.json. The row
/// stopped pointing at the file. The file stayed.
///
/// Three live statements said otherwise, one of them statutory: the privacy
/// policy's ImageKit row ("deleted once reviewed — only the outcome is kept"),
/// the PAIA manual ("Documents are deleted on decision"), and the line shown to
/// a tenant at the moment they upload their ID ("deleted as soon as someone has
/// looked at it"). A promise nobody implemented is worse than no promise: the
/// person relying on it is the one who uploaded their ID.
///
/// ── Why a queue and not a delete call
///
/// The bytes live at a third party, so deletion can fail for reasons that have
/// nothing to do with us — ImageKit down, a network blip, a credential rotated.
/// A fire-and-forget call would land us back where we started, quietly: the
/// difference between "deleted" and "we asked once and did not check" is the
/// whole point.
///
/// So the row is written in the SAME transaction that clears the reference, and
/// nothing marks it done until ImageKit confirms. `deletedAt` is set from the
/// response, never optimistically. A row that keeps failing stays here, visible
/// and countable, rather than dissolving into a log line.
///
/// ── What the two timestamps mean, because they are different promises
///
/// Clearing `documentPath` makes a document unreachable through this API
/// immediately — that part never depended on ImageKit. `deletedAt` here is the
/// stronger claim, that the bytes are gone. The audit trail shown to the
/// subject distinguishes them rather than asserting the stronger one early.
model FileDeletion {
  id String @id @default(uuid())

  /// ImageKit filePath, stored exactly as the upload returned it (no leading
  /// slash — see UploadsService). Not a URL: the delete API resolves a path to
  /// a fileId, and a URL with transforms in it resolves to nothing.
  path String

  /// Why it is going, e.g. `verification_decided`, `lease_replaced`,
  /// `lease_removed`. Free text for a human reading the queue, never parsed.
  reason String

  /// The verification whose audit trail should learn when this completes. Null
  /// for files with no trail of their own. Deliberately NOT a foreign key
  /// relation: the deletion must still happen, and still be recorded, if the
  /// request row is ever removed.
  verificationRequestId String?

  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  /// The last failure, kept so a stuck row can be diagnosed without replaying
  /// it. Never contains the file's contents — only ImageKit's own message.
  lastError     String?

  /// Set ONLY from a successful ImageKit response. While this is null the
  /// bytes are still there, whatever any other row says.
  deletedAt DateTime?

  /// True when ImageKit reported the file already absent. Distinguished from a
  /// deletion we performed, because "it was not there" and "we removed it" are
  /// different facts and only one of them is reassuring.
  alreadyGone Boolean @default(false)

  createdAt DateTime @default(now())

  /// The queue's working order: outstanding rows oldest first.
  @@index([deletedAt, createdAt])
  @@map("file_deletions")
}

/// What kind of paper this is. Narrow on purpose — a long list is a taxonomy
/// nobody maintains, and the point is to find the lease again, not to file it.
enum LeaseDocumentKind {
  /// The lease itself, signed on paper and photographed or scanned.
  lease
  /// An addendum or a renewal letter attached to an existing lease.
  addendum
  /// The inventory or condition report taken at move-in.
  inspection
  /// Proof of the deposit having been paid or refunded. NOT the deposit — see
  /// the warning below.
  deposit_receipt
  other
}

/// A lease document a landlord has stored against a tenancy.
///
/// ── Storage only. Read this before adding to it.
///
/// This model holds a FILE and who uploaded it. It does not sign anything,
/// witness anything, timestamp anything for evidential purposes, or assert that
/// the parties agreed to what the file says. There is deliberately no
/// `signedByTenantAt`, no signature image, no hash chain and no certificate,
/// because each of those would be this product asserting something about the
/// execution of a legal document — and a half-built e-signature is worse than
/// none, since it looks like one.
///
/// A landlord and a tenant sign on paper, and Mastande keeps the photograph so
/// neither has to find it in a drawer two years later. That is the whole
/// feature. If e-signature is ever wanted it is a separate decision with
/// ECT Act s.13 advice behind it, not an extra column here.
///
/// Likewise `deposit_receipt` is PROOF that a deposit moved between the two of
/// them. Mastande never holds the deposit, never confirms the amount arrived,
/// and nothing here should be read as an escrow record.
///
/// ── Who can see it
///
/// Both parties to the tenancy, and nobody else — not other landlords, not
/// admins. A lease names both people, what they pay and where they live, so the
/// landlord who owns the room is not the only person with a claim on it. The
/// tenant can read and download; only the uploader can replace or remove, so
/// one party cannot quietly delete the other's copy of what was agreed.
///
/// ── POPIA
///
/// A lease is personal information about both parties under s.1, not special
/// personal information under s.26 — it is a contract, not an identity
/// document. So unlike a verification document it is KEPT rather than deleted
/// on sight: both parties need it for as long as the tenancy can be disputed,
/// and deleting the only copy of an agreement would be the harm, not the
/// safeguard.
///
/// What that does NOT mean is kept forever. Removal is a real deletion through
/// FileDeletion — the bytes go from ImageKit, not just the row — and the
/// retention rule is stated where a person can read it rather than inferred
/// from behaviour.
model LeaseDocument {
  id String @id @default(uuid())

  tenancyId String
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  /// Who put it there. Either party may upload; only this person may replace or
  /// remove it. Not a cascade delete: the account going away must not take the
  /// other party's copy of the agreement with it, so this is an id, and the
  /// screen falls back to "a former user" when it no longer resolves.
  uploadedById String

  kind LeaseDocumentKind @default(lease)

  /// ImageKit filePath, no leading slash, like every other stored file here.
  /// Private: never rendered through a public URL, only through a signed read.
  path String

  /// What the landlord called it, or the original filename. Shown as-is so a
  /// yard with four leases is navigable.
  label String

  /// Bytes, as reported by the upload. Shown to the reader so they know what
  /// a download will cost them on mobile data, which in this market is the
  /// difference between opening it and not.
  sizeBytes Int?

  /// The file's own type, e.g. `application/pdf`, `image/jpeg`. Stored rather
  /// than guessed from the extension.
  contentType String?

  /// The landlord's own note. Never shown to the tenant as advice.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenancyId, createdAt])
  @@map("lease_documents")
}

/// A landlord's private note about a tenant — Phase 5e.
///
/// ── Whose it is, and who can never see it
///
/// Written by one landlord, visible to that landlord only. Not to the tenant,
/// not to other landlords, not to admins. There is no endpoint that returns
/// somebody else's notes, and that is the whole design: the moment a note could
/// be read by anyone but its author it stops being a memory aid and becomes an
/// unregulated reference that follows a person around.
///
/// ── Why it outlives the tenancy
///
/// It is deliberately keyed on the TENANT, not on a tenancy. A landlord who let
/// to someone two years ago and is looking at their application again needs what
/// they wrote at the time — that is the entire value. So a tenancy ending does
/// not remove the note.
///
/// ── POPIA
///
/// This is personal information about the tenant held by the landlord, and
/// Mastande is the operator processing it on their behalf. Three consequences,
/// all enforced in code rather than asked for politely:
///
///   · a tenant exercising their s.23 right of access must be able to get these,
///     because "the landlord wrote it" does not make it invisible to the data
///     subject — there is an admin-assisted path for that, logged;
///   · a note is deleted when its AUTHOR's account goes, because it was theirs;
///   · a note is deleted when the TENANT's account goes, because it is about
///     them and they have a s.24 right to erasure.
///
/// Both cascades are set below. The second one is the less obvious and the more
/// important: without it, deleting a tenant would leave notes about a person who
/// has asked to be forgotten.
///
/// ── Not a rating, and not shareable
///
/// There is no score, no stars, no flag, and nothing here feeds the review
/// system or a tenant's Passport. A structured private rating would be a shadow
/// credit score assembled from opinions, which is precisely what Phase 1 exists
/// to avoid. Phase 1's landlord-reference check is a separate, consented flow
/// where a previous landlord answers a specific question knowingly — this model
/// must never be wired into it, and nothing here blocks it being built.
model LandlordNote {
  id String @id @default(uuid())

  /// The author. Their account going takes their notes with it.
  landlordId String
  landlord   User   @relation("NotesWritten", fields: [landlordId], references: [id], onDelete: Cascade)

  /// The person it is about. Their account going takes it too — see POPIA above.
  tenantId String
  tenant   User   @relation("NotesAbout", fields: [tenantId], references: [id], onDelete: Cascade)

  /// The landlord's own words. No structure, no score, on purpose.
  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One landlord's notes about one tenant, newest first.
  @@index([landlordId, tenantId, createdAt])
  @@map("landlord_notes")
}

/// Something the app needs to tell someone, held where it cannot go missing.
///
/// ── Why this exists at all
///
/// Email stopped being required in v1.85.0 (Phase 7g), because many township
/// landlords are WhatsApp-first and do not use one. That immediately created a
/// way to lose a person's applications silently: every notification in this
/// codebase was `sendSomethingEmail(user.email, …)`, and for an account with no
/// address that is a send to nowhere.
///
/// WhatsApp is the obvious substitute and is NOT sufficient on its own. Every
/// outbound message here is free-form `type: 'text'`, which Meta permits only
/// inside the 24-hour customer service window; a business-initiated message
/// outside it is rejected with error 131047 unless an approved template exists,
/// and the templates are not approved yet. A fallback that fails whenever the
/// person has not messaged recently is not a fallback.
///
/// So: a row here is written for anyone who cannot be emailed. It is the channel
/// that works regardless of Meta, the hour, or a template queue.
///
/// ── The WhatsApp attempt is recorded, not assumed
///
/// `whatsappSentAt` is set only when the send returns success, and
/// `whatsappError` holds the reason when it does not. The same rule as
/// FileDeletion: a delivery nobody confirmed is not a delivery, and the codebase
/// has already been bitten once by a column whose name asserted something that
/// never happened.
model Notice {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Machine name, e.g. `new_application`, `shortlisted`, `room_unavailable`.
  /// Mirrors the email template names so the two channels stay recognisably the
  /// same event.
  kind String

  /// What it says, in the plain English the rest of the portal uses.
  title String
  body  String?

  /// Where to go about it, as an in-app path. Never an absolute URL: this is
  /// rendered inside the app, and a hardcoded host is how a staging link ends up
  /// in a production notice.
  link String?

  readAt DateTime?

  /// Set ONLY from a successful WhatsApp send. Null means it was not delivered
  /// that way — which is the normal case outside the 24-hour window.
  whatsappSentAt DateTime?
  /// Why the WhatsApp attempt failed, when it did. Meta's own message.
  whatsappError  String?

  createdAt DateTime @default(now())

  /// The unread list, newest first.
  @@index([userId, readAt, createdAt])
  @@map("notices")
}

/**
 * A sign-up in progress, by phone number, before any account exists — Phase 7g.
 * ── Why this is not just a User row with phoneVerified: false
 * That was the obvious shape and it is wrong. Creating the User first means
 * anybody who can type a number into a public endpoint creates an account for
 * somebody else's handset: a row with their number on it, countable in "users",
 * reachable by the deletion and notification machinery, and sitting in the way
 * when the real owner later tries to sign up. A sign-up attempt is not a person
 * agreeing to anything, so it does not get to be a person here.
 * So the number is proven FIRST, in this table, and the User is created only at
 * the final step, by the person themselves, with their own acceptance of the
 * terms. Rows that never get that far are deleted (see the cron in
 * PhoneSignupService) — POPIA minimisation: an abandoned attempt leaves us
 * holding the mobile number of someone who never joined.
 * ── It is also the consent record
 * `consentAcceptedAt` with `userId` is the evidence that this account's owner
 * ticked the box themselves, which is the one thing an assisted sign-up must
 * never be able to fake. Kept for as long as the account exists and cascaded
 * away with it, because a deleted account has no consent left to evidence.
 */
model PhoneSignup {
  id String @id @default(uuid())

  /// Canonical +27… form, from normaliseSaMobile. Not unique: one row per code
  /// REQUESTED — the same shape as AuthToken, so the rate limits are a count of
  /// rows in a window rather than a counter that resets when somebody starts
  /// over. A number may also be signed up again after an account is deleted.
  phone String

  /// HMAC of the six-digit code, keyed with the server secret — same scheme as
  /// AuthToken, for the same reason (a read-only database leak must not hand out
  /// live codes). Cleared once the number is proven, so a used code is gone
  /// rather than merely marked.
  codeHash  String?
  expiresAt DateTime

  /// Wrong guesses against this code. Capped in the service. The column exists
  /// because AuthToken.attempts had to be added for exactly this, and the cap
  /// was a comment for three releases without it.
  attempts Int @default(0)

  /// Set when a correct code is entered. From here the number is proven and the
  /// only thing left is who this person is.
  verifiedAt DateTime?

  /// A short-lived bearer of "this number is proven", so the last step does not
  /// have to take the code again (and so the code is not sitting in a form while
  /// someone types their name). Hashed, like every other token here.
  ticketHash      String?   @unique
  ticketExpiresAt DateTime?

  /// When the person accepted the Terms, Privacy Policy and POPIA processing,
  /// by their own tick. Null on every row that never completed.
  consentAcceptedAt DateTime?

  /// The account this became. Null while in flight; set once, with the consent.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which admin started this one for somebody — Phase 7p.
  ///
  /// ⚠️ This is the ONLY thing assisted sign-up adds, because the control that
  /// makes it safe was already here: `complete` takes `acceptTerms` from the
  /// request and records it against this row, and no helper can reach that step
  /// without the code that went to the person's own handset. Help reaches the
  /// handset; the consent stops at the person.
  ///
  /// Admin-recorded rather than open to any signed-in account: there is no agent
  /// role in this product, and an open version would be a way to send sign-up
  /// codes to arbitrary numbers with somebody else's name against the record.
  ///
  /// **Never in a user-facing payload.** Internal accountability, the same rule
  /// as ServiceProvider.checkedByAdminId.
  ///
  /// SET NULL rather than cascade: an admin closing their own account must not
  /// delete the sign-up records of the people they helped.
  assistedByAdminId String?
  assistedBy        User?   @relation("PhoneSignupsAssisted", fields: [assistedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The live-row lookup: newest unconsumed attempt for a number.
  @@index([phone, userId, createdAt])
  /// "The sign-ups I started" — the screen that makes the record readable.
  @@index([assistedByAdminId, createdAt])
  @@map("phone_signups")
}
